{% liquid
  assign heading = section.settings.heading | default: 'Opening soon'
  assign subheading = section.settings.subheading | default: 'Join the list. New pieces, first.'
  assign logo_alt = 'accessibility.home_logo_alt' | t: store_name: shop.name
%}

<div class="favrik-password">
  <div class="favrik-password__stage">
    <img
      src="{{ 'favrik_logo.png' | asset_url }}"
      class="favrik-password__logo"
      alt="{{ logo_alt | escape }}"
      width="280"
      height="75"
    >

    <div class="favrik-password__copy">
      <h1 class="favrik-password__heading">{{ heading | escape }}</h1>
      {%- if shop.password_message != blank -%}
        <div class="favrik-password__message">{{ shop.password_message }}</div>
      {%- elsif subheading != blank -%}
        <p class="favrik-password__subheading">{{ subheading | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="favrik-password__locations">
      <li>Emporium Melbourne</li>
    </ul>

    {%- form 'customer', class: 'favrik-password__form' -%}
      <input
        type="hidden"
        name="contact[tags]"
        value="newsletter,password page"
      >
      <label
        class="visually-hidden"
        for="FavrikPasswordEmail"
      >
        {{ 'blocks.email_signup.label' | t }}
      </label>
      <div class="favrik-password__fields">
        <input
          id="FavrikPasswordEmail"
          class="favrik-password__input"
          type="email"
          name="contact[email]"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="FavrikPasswordEmail-error"
          {% endif %}
        >
        <button
          class="favrik-password__submit"
          type="submit"
        >
          {{ 'actions.sign_up' | t }}
        </button>
      </div>
      {%- if form.errors -%}
        <p
          id="FavrikPasswordEmail-error"
          class="favrik-password__status favrik-password__status--error"
        >
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <p class="favrik-password__status">{{ 'blocks.email_signup.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .section-password {
    flex-grow: 1;
    display: flex;
    background: #fff7ec;
  }

  .favrik-password {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100%;
    padding: 4.5rem var(--page-margin) 2rem;
    box-sizing: border-box;
    background: #fff7ec;
    color: #302118;
  }

  .favrik-password__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(26rem, 100%);
    text-align: center;
  }

  .favrik-password__logo {
    display: block;
    width: auto;
    height: 3rem;
    object-fit: contain;
  }

  .favrik-password__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    margin-block-start: 2.75rem;
  }

  .favrik-password__heading,
  .favrik-password__subheading,
  .favrik-password__message,
  .favrik-password__message p,
  .favrik-password__locations,
  .favrik-password__input,
  .favrik-password__submit,
  .favrik-password__status {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .favrik-password__heading {
    color: #302118;
  }

  .favrik-password__subheading,
  .favrik-password__message,
  .favrik-password__message p {
    max-width: 22rem;
    color: rgb(48 33 24 / 0.62);
  }

  .favrik-password__locations {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
    margin-block-start: 1.75rem;
    padding: 0;
    list-style: none;
    color: #302118;
  }

  .favrik-password__form {
    width: 100%;
    margin-block-start: 2rem;
  }

  .favrik-password__fields {
    display: flex;
    width: 100%;
    border: 1px solid #302118;
    border-radius: 0;
    background: #fff7ec;
  }

  .favrik-password__input {
    flex: 1 1 auto;
    min-width: 0;
    height: 2.75rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: 0;
    background: #fff7ec;
    color: #302118;
    box-shadow: none;
    appearance: none;
  }

  .favrik-password__input::placeholder {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.06em;
    color: rgb(48 33 24 / 0.45);
    text-transform: uppercase;
  }

  .favrik-password__input:focus {
    outline: none;
  }

  .favrik-password__submit {
    flex: 0 0 auto;
    height: 2.75rem;
    padding: 0 1.1rem;
    border: 0;
    border-left: 1px solid #302118;
    border-radius: 0;
    background: #302118;
    color: #fff7ec;
    cursor: pointer;
  }

  .favrik-password__status {
    margin-block-start: 0.75rem;
    color: #302118;
  }

  .favrik-password__status--error {
    color: #8a2a1b;
  }

  @media screen and (min-width: 750px) {
    .favrik-password__logo {
      height: 4.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.section",
  "class": "section-wrapper section-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join the list. New pieces, first."
    }
  ]
}
{% endschema %}
