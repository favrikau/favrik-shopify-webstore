{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  if collection.handle == 'all'
    assign title_en = section.settings.heading_en
    if title_en == blank
      assign title_en = 'ALL'
    endif
  else
    assign title_en = section.settings.heading_en
    if title_en == blank
      assign title_en = collection.title
    endif
  endif

  assign heading_color = section.settings.heading_color | default: '#302118'
  assign label_color = section.settings.label_color | default: '#8a7268'
  assign products_count = collection.products_count | default: 0
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  <div
    class="collection-page-header spacing-style"
    style="
      {% render 'spacing-style', settings: section.settings %}
      --collection-header-title-color: {{ heading_color }};
      --collection-header-label-color: {{ label_color }};
    "
  >
    <div class="collection-page-header__row">
      <h1 class="collection-page-header__heading">
        <span class="collection-page-header__label">COLLECTION</span>
        <span class="collection-page-header__title">{{ title_en | escape }}</span>
      </h1>

      <p class="collection-page-header__count" role="status" data-testid="products-count">
        {% if products_count > 25000 %}
          {{- 'content.item_count_cutoff' | t: count: 25000 -}}
        {% else %}
          {{- 'content.item_count' | t: count: products_count -}}
        {% endif %}
      </p>
    </div>

    {% if section.settings.show_description and collection.description != blank and collection.handle != 'on-sale' %}
      <div class="collection-page-header__description rte">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .collection-page-header {
    width: 100%;
    /* Extra top breathing room under the header on all collection pages */
    padding-block-start: calc(var(--padding-block-start, 0px) + var(--section-top-offset, 0px) + 8px);
  }

  .collection-page-header__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    width: 100%;
  }

  .collection-page-header__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    margin: 0;
    min-width: 0;
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .collection-page-header__label {
    color: var(--collection-header-label-color, #8a7268);
    font-weight: 300;
  }

  .collection-page-header__title {
    color: var(--collection-header-title-color, #302118);
    font-weight: 300;
  }

  .collection-page-header__count {
    margin: 0;
    flex-shrink: 0;
    color: var(--collection-header-title-color, #302118);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .collection-page-header__description {
    margin-block-start: 12px;
    max-width: 65ch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection heading",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading_en",
      "label": "Heading override",
      "info": "Leave blank to use the collection name."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#302118"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "COLLECTION label color",
      "default": "#8a7268"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Collection heading"
    }
  ]
}
{% endschema %}
