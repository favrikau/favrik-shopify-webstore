{% liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections['fw2026']
  endif

  assign secondary_link = section.settings.secondary_link | default: routes.root_url

  assign hero_image = section.settings.image
  if hero_image == blank
    for product in collection.products
      if product.featured_image != blank
        assign hero_image = product.featured_image
        break
      endif
    endfor
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  class="section section--full-width not-found{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  aria-labelledby="NotFoundHeading-{{ section.id }}"
>
  <div class="not-found__layout force-full-width">
    <div class="not-found__content">
      {% if section.settings.kicker != blank %}
        <p class="not-found__kicker">{{ section.settings.kicker | escape }}</p>
      {% endif %}

      <h1
        id="NotFoundHeading-{{ section.id }}"
        class="not-found__heading"
      >
        {{ section.settings.heading | escape }}
      </h1>

      {% if section.settings.subheading != blank %}
        <p class="not-found__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}

      <div class="not-found__actions">
        {% if section.settings.secondary_label != blank %}
          <a
            class="not-found__button"
            href="{{ secondary_link }}"
          >
            {{- section.settings.secondary_label | escape -}}
          </a>
        {% endif %}
      </div>

      {% liquid
        assign quick_links = section.settings.menu.links
        assign contact_page = pages['contact']
      %}
      <nav
        class="not-found__links"
        aria-label="{{ section.settings.links_heading | default: 'Explore' | escape }}"
      >
        {% if section.settings.links_heading != blank %}
          <p class="not-found__links-heading">{{ section.settings.links_heading | escape }}</p>
        {% endif %}
        <ul class="not-found__links-list list-unstyled">
          {% if quick_links.size > 0 %}
            {% for link in quick_links %}
              <li>
                <a
                  class="not-found__link"
                  href="{{ link.url }}"
                >
                  {{- link.title | escape -}}
                </a>
              </li>
            {% endfor %}
          {% else %}
            <li><a class="not-found__link" href="{{ routes.root_url }}">Home</a></li>
            <li><a class="not-found__link" href="{{ routes.all_products_collection_url }}">Shop all</a></li>
            {% if contact_page != blank %}
              <li><a class="not-found__link" href="{{ contact_page.url }}">Contact</a></li>
            {% endif %}
          {% endif %}
        </ul>
      </nav>
    </div>

    <div
      class="not-found__media"
      aria-hidden="true"
    >
      {% if hero_image != blank %}
        {{
          hero_image
          | image_url: width: 2000
          | image_tag:
            widths: '600, 900, 1200, 1600, 2000',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'not-found__image',
            loading: 'eager',
            alt: ''
        }}
      {% else %}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'not-found__image not-found__image--placeholder' }}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .not-found {
    width: 100%;
  }

  .not-found__layout {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: calc(100dvh - var(--header-group-height, 0px));
  }

  .not-found__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding: 2.5rem var(--page-margin) 2rem;
    color: #302118;
  }

  .not-found__kicker,
  .not-found__heading,
  .not-found__subheading,
  .not-found__links-heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 300;
    text-transform: uppercase;
  }

  .not-found__kicker,
  .not-found__links-heading {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: rgb(48 33 24 / 0.55);
  }

  .not-found__heading {
    /* Single line: sized to the column so the heading never wraps. */
    white-space: nowrap;
    font-size: clamp(1rem, 4.8vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: 0.06em;
    color: #302118;
  }

  .not-found__subheading {
    max-width: 34rem;
    font-size: 0.75rem;
    line-height: 1.6;
    letter-spacing: 0.06em;
    color: rgb(48 33 24 / 0.62);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-block-start: 0.5rem;
  }

  .not-found__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.5rem;
    border: 0.5px solid #302118;
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    background: #302118;
    color: #f3eee7;
    transition:
      background-color 0.25s var(--ease-out-cubic, ease),
      color 0.25s var(--ease-out-cubic, ease);
  }

  .not-found__button:hover {
    background: transparent;
    color: #302118;
  }

  .not-found__links {
    display: grid;
    gap: 0.625rem;
    margin-block-start: 1.25rem;
    padding-block-start: 1.25rem;
    border-block-start: 0.5px solid rgb(48 33 24 / 0.2);
  }

  .not-found__links-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
  }

  .not-found__link {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: #302118;
    transition: opacity 0.2s ease;
  }

  .not-found__link:hover {
    opacity: 0.6;
  }

  .not-found__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgb(48 33 24 / 0.06);
  }

  .not-found__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media screen and (min-width: 990px) {
    .not-found__layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .not-found__content {
      padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3.5rem);
    }

    .not-found__heading {
      font-size: clamp(1.25rem, 2vw, 1.875rem);
    }

    .not-found__media {
      aspect-ratio: auto;
      height: 100%;
      min-height: 26rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page not found",
  "tag": "div",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Page not found"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This page has moved on."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "The link may be out of date, or the piece you were looking for has sold through. Start again from our latest collection."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Button label",
      "default": "Back to home"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Button link",
      "info": "Defaults to the home page."
    },
    {
      "type": "header",
      "content": "Quick links"
    },
    {
      "type": "text",
      "id": "links_heading",
      "label": "Heading",
      "default": "Or explore"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Leave empty to show Home, Shop all and Contact."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the first product image from the collection below."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used for the image. Defaults to FW2026."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}
