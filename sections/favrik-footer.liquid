{% liquid
  assign about_url = section.settings.about_url
  if about_url == blank and pages['about'] != blank
    assign about_url = pages['about'].url
  elsif about_url == blank
    assign about_url = '/pages/about'
  endif

  assign collections_url = section.settings.collections_url
  if collections_url == blank
    assign collections_url = routes.all_products_collection_url
  endif

  assign returns_url = section.settings.returns_policy_url
  if returns_url == blank and pages['returns-policy'] != blank
    assign returns_url = pages['returns-policy'].url
  elsif returns_url == blank and shop.refund_policy != blank
    assign returns_url = shop.refund_policy.url
  elsif returns_url == blank
    assign returns_url = '/pages/returns-policy'
  endif

  assign privacy_url = section.settings.privacy_policy_url
  if privacy_url == blank and pages['privacy-policy'] != blank
    assign privacy_url = pages['privacy-policy'].url
  elsif privacy_url == blank and shop.privacy_policy != blank
    assign privacy_url = shop.privacy_policy.url
  elsif privacy_url == blank
    assign privacy_url = '/pages/privacy-policy'
  endif

  assign terms_url = section.settings.terms_of_use_url
  if terms_url == blank and pages['terms-of-use'] != blank
    assign terms_url = pages['terms-of-use'].url
  elsif terms_url == blank and shop.terms_of_service != blank
    assign terms_url = shop.terms_of_service.url
  elsif terms_url == blank
    assign terms_url = '/pages/terms-of-use'
  endif

  assign locations_url = section.settings.locations_url
  if locations_url == blank and pages['locations'] != blank
    assign locations_url = pages['locations'].url
  elsif locations_url == blank
    assign locations_url = '/pages/locations'
  endif

  assign contact_url = section.settings.contact_url
  if contact_url == blank and pages['contact'] != blank
    assign contact_url = pages['contact'].url
  elsif contact_url == blank
    assign contact_url = '/pages/contact'
  endif

  assign background_color = section.settings.background_color | default: '#f3eee7'
  assign text_color = section.settings.text_color | default: '#302118'
  assign muted_color = section.settings.muted_text_color | default: '#8a7268'

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign legal_company = section.settings.company_name
  if legal_company == blank
    assign legal_company = shop.name
  endif

  assign legal_email = section.settings.email
  if legal_email == blank
    assign legal_email = shop.email
  endif

  assign store_address = section.settings.address
  if store_address == blank and shop.address != blank
    assign store_address = shop.address | format_address | strip_html | strip_newlines
  endif
  if store_address == blank
    assign store_address = 'Emporium, Lower Ground, Shop 27a/287 Lonsdale St, Melbourne VIC 3000'
  endif

  assign opening_hours = section.settings.opening_hours

  assign copyright_name = section.settings.copyright_name
  if copyright_name == blank
    assign copyright_name = shop.name
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="favrik-footer section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --favrik-footer-bg: {{ background_color }};
    --favrik-footer-text: {{ text_color }};
    --favrik-footer-muted: {{ muted_color }};
    {% render 'spacing-style', settings: section.settings %}
  "
  data-testid="favrik-footer"
>
  <div class="favrik-footer__inner">
    <div class="favrik-footer__grid">
      <div class="favrik-footer__column favrik-footer__column--info">
        {% if store_address != blank %}
          <div class="favrik-footer__info-block">
            <p class="favrik-footer__info-label">Store address</p>
            <p class="favrik-footer__info-text">{{ store_address | escape | replace: ', Melbourne VIC 3000', '<br>Melbourne VIC 3000' | newline_to_br }}</p>
          </div>
        {% endif %}

        {% if opening_hours != blank %}
          <div class="favrik-footer__info-block">
            <p class="favrik-footer__info-label">Opening hours</p>
            <p class="favrik-footer__info-text">{{ opening_hours | escape | newline_to_br }}</p>
          </div>
        {% endif %}
      </div>

      <nav class="favrik-footer__column favrik-footer__column--company" aria-label="Company">
        <ul class="favrik-footer__link-list list-unstyled">
          <li class="favrik-footer__link-item">
            <a href="{{ about_url }}" class="favrik-footer__link">About</a>
          </li>
          <li class="favrik-footer__link-item">
            <a
              href="#"
              class="favrik-footer__link"
              data-catalog-nav-trigger
              aria-controls="catalog-nav-drawer"
              aria-expanded="false"
              role="button"
            >
              Catalog
            </a>
          </li>
          <li class="favrik-footer__link-item">
            <a href="{{ locations_url }}" class="favrik-footer__link">Locations</a>
          </li>
        </ul>
      </nav>

      <nav class="favrik-footer__column favrik-footer__column--connect" aria-label="Connect">
        <ul class="favrik-footer__link-list list-unstyled">
          <li class="favrik-footer__link-item">
            <a href="{{ returns_url }}" class="favrik-footer__link">Returns Policy</a>
          </li>
          <li class="favrik-footer__link-item">
            <a href="{{ contact_url }}" class="favrik-footer__link">Contact Us</a>
          </li>
          <li class="favrik-footer__link-item">
            <a
              href="#email-marketing-popup-panel"
              class="favrik-footer__link"
              data-email-popup-trigger
              aria-controls="email-marketing-popup-panel"
              aria-expanded="false"
              role="button"
            >
              Join the list
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="favrik-footer__meta">
      <div class="favrik-footer__meta-start">
        {% if section.settings.designer_credit != blank %}
          <p class="favrik-footer__credit">{{ section.settings.designer_credit | escape }}</p>
        {% endif %}
      </div>

      <div class="favrik-footer__meta-center">
        {% if section.settings.show_legal_notice %}
          <p class="favrik-footer__legal-single">
            {{ legal_company | escape }}
            {%- if section.settings.phone != blank -%}
              · {{ section.settings.phone | escape }}
            {%- endif -%}
            {%- if legal_email != blank -%}
              · <a href="mailto:{{ legal_email | escape }}">{{ legal_email | escape }}</a>
            {%- endif -%}
            {%- if section.settings.abn != blank -%}
              · ABN {{ section.settings.abn | escape }}
            {%- endif -%}
            · &copy; {{ 'now' | date: '%Y' }} {{ copyright_name | escape }}
          </p>
          <span class="favrik-footer__meta-dot" aria-hidden="true">·</span>
        {% endif %}
        <p class="favrik-footer__policies">
          <a href="{{ privacy_url }}">Privacy Policy</a>
          · <a href="{{ terms_url }}">Terms of Use</a>
        </p>
      </div>

      <div class="favrik-footer__meta-end">
        {% if section.settings.show_payment_icons %}
          <div class="favrik-footer__payments">
            <span class="visually-hidden">{{ 'blocks.payment_methods' | t }}</span>
            <ul class="favrik-footer__payment-list list-unstyled" role="list">
              <li class="favrik-footer__payment-item">
                <img
                  src="{{ 'payment-apple-pay.png' | asset_url }}"
                  alt="Apple Pay"
                  class="favrik-footer__payment-icon"
                  width="130"
                  height="64"
                  loading="lazy"
                >
              </li>
              <li class="favrik-footer__payment-item">
                <img
                  src="{{ 'payment-visa.png' | asset_url }}"
                  alt="Visa"
                  class="favrik-footer__payment-icon favrik-footer__payment-icon--visa"
                  width="171"
                  height="64"
                  loading="lazy"
                >
              </li>
              <li class="favrik-footer__payment-item">
                <img
                  src="{{ 'payment-mastercard.png' | asset_url }}"
                  alt="Mastercard"
                  class="favrik-footer__payment-icon"
                  width="93"
                  height="64"
                  loading="lazy"
                >
              </li>
              <li class="favrik-footer__payment-item">
                <img
                  src="{{ 'payment-google-pay.png' | asset_url }}"
                  alt="Google Pay"
                  class="favrik-footer__payment-icon favrik-footer__payment-icon--google-pay"
                  width="256"
                  height="256"
                  loading="lazy"
                >
              </li>
              <li class="favrik-footer__payment-item">
                <img
                  src="{{ 'payment-amex.png' | asset_url }}"
                  alt="American Express"
                  class="favrik-footer__payment-icon favrik-footer__payment-icon--amex"
                  width="512"
                  height="512"
                  loading="lazy"
                >
              </li>
            </ul>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .favrik-footer {
    --favrik-footer-padding-top: clamp(2rem, 4vw, 2.75rem);
    --favrik-footer-padding-bottom: var(--padding-md);

    background-color: var(--favrik-footer-bg);
    color: var(--favrik-footer-text);
    padding-block-start: var(--favrik-footer-padding-top);
    padding-block-end: var(--favrik-footer-padding-bottom);
  }

  .favrik-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    margin-inline: auto;
    /* Page-width sections already sit in the site gutter; don’t add a second inset. */
    padding-inline: 0;
  }

  .favrik-footer.section--full-width .favrik-footer__inner {
    padding-inline: var(--page-margin);
  }

  .favrik-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .favrik-footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
      align-items: start;
    }
  }

  .favrik-footer__column {
    min-width: 0;
  }

  .favrik-footer__column--info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .favrik-footer__column:not(.favrik-footer__column--info) {
      padding-top: 0.125rem;
    }
  }

  .favrik-footer__info-block {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .favrik-footer__info-label {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    font-weight: var(--font-body--weight);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--favrik-footer-text);
  }

  .favrik-footer__info-text {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: var(--font-body--weight);
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--favrik-footer-muted);
  }

  .favrik-footer__link-list {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.625rem;
    width: 100%;
  }

  .favrik-footer__link-item {
    width: 100%;
  }

  .favrik-footer__link {
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    font-weight: var(--font-body--weight);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--favrik-footer-text);
    transition: opacity 0.25s var(--ease-out-cubic, ease);
  }

  .favrik-footer__link:hover,
  .favrik-footer__link:focus-visible {
    opacity: 0.55;
  }

  .favrik-footer__meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto) minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding-top: 1rem;
    border-top: 0.5px solid rgb(48 33 24 / 0.08);
  }

  .favrik-footer__meta-start {
    justify-self: start;
  }

  .favrik-footer__meta-center {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    justify-self: center;
    gap: 0 0.4em;
    text-align: center;
    min-width: 0;
  }

  .favrik-footer__meta-end {
    justify-self: end;
  }

  .favrik-footer__credit,
  .favrik-footer__legal-single,
  .favrik-footer__policies,
  .favrik-footer__meta-dot {
    margin: 0;
    font-size: 0.625rem;
    font-weight: var(--font-body--weight);
    letter-spacing: 0.02em;
    line-height: 1.4;
    color: var(--favrik-footer-muted);
  }

  .favrik-footer__credit {
    font-family: var(--font-body--family);
    text-align: left;
    white-space: nowrap;
  }

  .favrik-footer__legal-single {
    font-family: var(--font-body--family);
    text-align: center;
  }

  .favrik-footer__policies {
    font-family: var(--font-body--family);
    text-align: center;
    white-space: nowrap;
  }

  .favrik-footer__legal-single a,
  .favrik-footer__policies a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.25s var(--ease-out-cubic, ease);
  }

  .favrik-footer__legal-single a:hover,
  .favrik-footer__legal-single a:focus-visible,
  .favrik-footer__policies a:hover,
  .favrik-footer__policies a:focus-visible {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .favrik-footer__legal-single a[href^='mailto:'] {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .favrik-footer__payments {
    display: flex;
    justify-content: flex-end;
  }

  .favrik-footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .favrik-footer__payment-item {
    display: flex;
    align-items: center;
    line-height: 0;
  }

  .favrik-footer__payment-icon {
    display: block;
    height: 1.125rem;
    width: auto;
    object-fit: contain;
    opacity: 0.65;
  }

  .favrik-footer__payment-icon--visa {
    height: 0.8125rem;
  }

  .favrik-footer__payment-icon--amex {
    height: 1.0625rem;
  }

  .favrik-footer__payment-icon--google-pay {
    height: 2rem;
  }

  @media screen and (max-width: 749px) {
    .favrik-footer {
      --favrik-footer-padding-top: 1.5rem;
    }

    .favrik-footer__inner {
      gap: 1rem;
    }

    .favrik-footer__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 1.25rem;
      row-gap: 1.25rem;
      align-items: start;
    }

    .favrik-footer__column--info {
      grid-column: 1 / -1;
      gap: 0.85rem;
    }

    .favrik-footer__link-list {
      gap: 0.5rem;
    }

    .favrik-footer__meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      column-gap: 0.45em;
      row-gap: 0.55rem;
    }

    .favrik-footer__meta-center {
      display: contents;
    }

    .favrik-footer__meta-dot {
      display: none;
    }

    .favrik-footer__legal-single {
      flex: 1 0 100%;
      order: 1;
      text-align: center;
    }

    .favrik-footer__policies {
      order: 2;
    }

    .favrik-footer__meta-start {
      order: 3;
      width: auto;
    }

    .favrik-footer__credit {
      text-align: center;
      white-space: nowrap;
    }

    .favrik-footer__credit:not(:empty)::before {
      content: '·';
      margin-inline-end: 0.45em;
    }

    .favrik-footer__meta-end {
      flex: 1 0 100%;
      order: 4;
      text-align: center;
    }

    .favrik-footer__payments,
    .favrik-footer__payment-list {
      justify-content: center;
    }

    .favrik-footer__credit,
    .favrik-footer__legal-single,
    .favrik-footer__policies,
    .favrik-footer__meta-dot {
      font-size: 0.5625rem;
      line-height: 1.35;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Favrik footer",
  "tag": "section",
  "class": "favrik-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Column links"
    },
    {
      "type": "url",
      "id": "about_url",
      "label": "About URL"
    },
    {
      "type": "url",
      "id": "collections_url",
      "label": "Catalog URL"
    },
    {
      "type": "url",
      "id": "returns_policy_url",
      "label": "Returns policy URL"
    },
    {
      "type": "url",
      "id": "privacy_policy_url",
      "label": "Privacy policy URL"
    },
    {
      "type": "url",
      "id": "terms_of_use_url",
      "label": "Terms of use URL"
    },
    {
      "type": "url",
      "id": "locations_url",
      "label": "Locations URL"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact URL"
    },
    {
      "type": "header",
      "content": "Store details"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Store address",
      "default": "Emporium, Lower Ground, Shop 27a/287 Lonsdale St,\nMelbourne VIC 3000",
      "info": "Shown in the first footer column. Leave blank to use your store address from Shopify settings."
    },
    {
      "type": "textarea",
      "id": "opening_hours",
      "label": "Opening hours",
      "default": "Mon–Wed, Sat–Sun 11am–7pm\nThu–Fri 11am–8pm",
      "info": "Shown under the store address. Use a new line for each day or time."
    },
    {
      "type": "header",
      "content": "Legal notice"
    },
    {
      "type": "checkbox",
      "id": "show_legal_notice",
      "label": "Show legal notice",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true,
      "info": "Shows Apple Pay, Visa, Mastercard, Google Pay, and Amex in the footer."
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company name",
      "default": "Favrik Pty Ltd",
      "info": "Leave blank to use your store name."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "info": "Optional."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "favrik.au@gmail.com",
      "info": "Leave blank to use your store contact email."
    },
    {
      "type": "text",
      "id": "abn",
      "label": "ABN",
      "info": "Optional. Shown when provided."
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "default": "Favrik"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "text",
      "id": "designer_credit",
      "label": "Designer credit",
      "default": "Designed by RSD"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#f3eee7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#302118"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color",
      "default": "#8a7268"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Favrik footer",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
