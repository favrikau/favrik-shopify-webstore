{% liquid
  assign background_color = section.settings.background_color | default: settings.color_palette.background
  assign text_color = section.settings.text_color | default: settings.color_palette.foreground
  assign muted_color = section.settings.muted_text_color | default: '#7e736a'
  assign border_color = section.settings.border_color | default: '#d8cec3'

  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections['fw2026']
  endif
  if collection == blank
    assign collection = collections['dw2026']
  endif

  assign image_limit = 24
  assign images_rendered = 0
  assign fallback_image = null

  if background_color != blank
    render 'contrast-override', background_color: background_color, text_color: text_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  class="returns-policy-page section section--full-width{% if background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --returns-policy-text: {{ text_color }};
    --returns-policy-muted: {{ muted_color }};
    --returns-policy-border: {{ border_color }};
  "
>
  <div class="returns-policy-page__inner">
    <header class="returns-policy-page__header">
      <h1 class="returns-policy-page__title">Returns Policy</h1>
    </header>

    <div class="returns-policy-page__content">
      <section class="returns-policy-page__group" aria-labelledby="returns-policy-shipping">
        <h2 id="returns-policy-shipping" class="returns-policy-page__section-title">Shipping</h2>

        <article class="returns-policy-page__item">
          <h3 class="returns-policy-page__item-title">Sales And Promotional Event Orders</h3>
          <div class="returns-policy-page__copy">
            <p>
              During popular sales and promotions Favrik may be unable to dispatch your order in full because one or
              more products are out of stock as we prepare to dispatch your order. If this occurs, you will receive an
              email notification about the out of stock product(s) and an automatic refund to your payment method(s)
              used.
            </p>
            <p>
              Favrik may experience delays of up to three (3) business days in dispatching your order for delivery to
              you.
            </p>
          </div>
        </article>

        <article class="returns-policy-page__item">
          <h3 class="returns-policy-page__item-title">Delivery Address Review Delay</h3>
          <div class="returns-policy-page__copy">
            <p>
              Favrik orders require a valid delivery address which complies with Delivery Service requirements. We use a
              real-time address validation service at checkout to assist you to enter and select a valid delivery
              address.
            </p>
            <p>
              If you do not use the address validation service at checkout or manually override and enter an invalid
              delivery address, your order will be delayed until we can confirm a valid delivery address for your order.
            </p>
          </div>
        </article>

        <article class="returns-policy-page__item">
          <h3 class="returns-policy-page__item-title">Lost Or Delay In-Transit Orders</h3>
          <div class="returns-policy-page__copy">
            <p>
              If you have not received your Favrik order within 10 business days, please contact Customer Service, and
              we will request an investigation with the responsible Delivery Service.
            </p>
          </div>
        </article>
      </section>

      <section class="returns-policy-page__group" aria-labelledby="returns-policy-returns">
        <h2 id="returns-policy-returns" class="returns-policy-page__section-title">Returns</h2>

        <article class="returns-policy-page__item">
          <h3 class="returns-policy-page__item-title">Change Of Mind Policy</h3>
          <div class="returns-policy-page__copy">
            <p>
              While we do not offer a refund for change of mind, you may exchange the item or request a credit note
              within 14 days from the date of purchase or delivery. The exchange can be made one time only, and credit
              is valid for 1 year from the refund date and for single use only. Our policy does not exclude or replace
              your rights under the Australian Consumer Law and regulations.
            </p>
          </div>
        </article>

        <article class="returns-policy-page__item">
          <h3 class="returns-policy-page__item-title">Purchase In-store</h3>
          <div class="returns-policy-page__copy">
            <p>To be eligible for an exchange or credit note, the following conditions must be met:</p>
            <ul>
              <li>Proof of purchase is accompanied with the returned item.</li>
              <li>The item is unworn, unwashed, unused, and in its original condition with all tags intact.</li>
              <li>Any discounts received at the time of purchase will be carried over.</li>
            </ul>
          </div>
        </article>

        <article class="returns-policy-page__item">
          <h3 class="returns-policy-page__item-title">Purchase Online</h3>
          <div class="returns-policy-page__copy">
            <p>
              For online purchases, the in-store return option is available. You can exchange, but return postage and
              re-delivery cost are at your cost. To be eligible for an exchange or credit note, the following conditions
              must be met:
            </p>
            <ul>
              <li>Proof of purchase is accompanied with the returned item.</li>
              <li>The item is unworn, unwashed, unused, and in its original condition with all tags intact.</li>
              <li>Any discounts received at the time of purchase will be carried over.</li>
              <li>If the purchase included free shipping, the shipping fee will be deducted from the credit.</li>
            </ul>
          </div>
        </article>

        <article class="returns-policy-page__item">
          <h3 class="returns-policy-page__item-title">Exceptions</h3>
          <div class="returns-policy-page__copy">
            <p>Our change of mind policy does not apply to the following items:</p>
            <ul>
              <li>Sale items</li>
              <li>Accessories and home items</li>
              <li>Swimwear and underwear</li>
            </ul>
          </div>
        </article>
      </section>
    </div>
  </div>

  <div class="returns-policy-page__media" aria-hidden="true">
    {% if collection != blank %}
      <div
        class="returns-policy-page__image-pool"
        data-random-collection-image
        data-prefer-portrait="true"
      >
        {% for product in collection.products %}
          {% if product.featured_image == blank %}
            {% continue %}
          {% endif %}

          {% if fallback_image == blank %}
            {% assign fallback_image = product.featured_image %}
          {% endif %}

          {{
            product.featured_image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1500, 2000, 2400',
              sizes: '100vw',
              class: 'returns-policy-page__image resource-image__random-image',
              loading: 'lazy',
              alt: '',
              data-random-image: images_rendered,
              data-image-aspect: product.featured_image.aspect_ratio
          }}

          {% assign images_rendered = images_rendered | plus: 1 %}
          {% if images_rendered >= image_limit %}
            {% break %}
          {% endif %}
        {% endfor %}
      </div>

      {% if images_rendered == 0 and fallback_image != blank %}
        {{
          fallback_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            class: 'returns-policy-page__image',
            loading: 'lazy',
            alt: ''
        }}
      {% endif %}
    {% endif %}

    {% if images_rendered == 0 %}
      <div class="returns-policy-page__placeholder">
        {{ 'product-apparel-1' | placeholder_svg_tag: 'returns-policy-page__placeholder-svg' }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .returns-policy-page {
    color: var(--returns-policy-text);
    background: var(--color-background);
    padding-block-start: clamp(2.5rem, 5vw, 4rem);
    padding-block-end: 0;
  }

  .returns-policy-page__inner {
    width: min(100% - 2.5rem, 58rem);
    margin-inline: auto;
    margin-block-end: clamp(2.5rem, 5vw, 4rem);
  }

  .returns-policy-page__header {
    display: grid;
    gap: 0.75rem;
    margin-block-end: clamp(2rem, 4vw, 3rem);
  }

  .returns-policy-page__title,
  .returns-policy-page__section-title,
  .returns-policy-page__item-title {
    margin: 0;
    color: var(--returns-policy-text, #302118);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .returns-policy-page__title,
  .returns-policy-page__section-title {
    font-weight: 600;
  }

  .returns-policy-page__content {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .returns-policy-page__group {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    padding-block-start: clamp(1.25rem, 2.5vw, 1.75rem);
    border-block-start: 0.5px solid var(--returns-policy-border);
  }

  .returns-policy-page__item {
    display: grid;
    grid-template-columns: minmax(10rem, 0.38fr) minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: start;
  }

  .returns-policy-page__copy {
    display: grid;
    gap: 0.85rem;
    color: var(--returns-policy-muted);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.6;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .returns-policy-page__copy p,
  .returns-policy-page__copy ul {
    margin: 0;
  }

  .returns-policy-page__copy ul {
    display: grid;
    gap: 0.45rem;
    padding-inline-start: 1.1rem;
  }

  .returns-policy-page__copy li::marker {
    color: var(--returns-policy-text);
  }

  .returns-policy-page__media {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: rgb(48 33 24 / 0.06);
  }

  .returns-policy-page__image-pool {
    position: absolute;
    inset: 0;
  }

  .returns-policy-page__image,
  .returns-policy-page__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .returns-policy-page__image-pool .resource-image__random-image {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }

  .returns-policy-page__image-pool .resource-image__random-image.is-active,
  .returns-policy-page__image-pool .resource-image__random-image:first-child {
    opacity: 1;
    visibility: visible;
  }

  .returns-policy-page__image-pool:has(.resource-image__random-image.is-active)
    .resource-image__random-image:first-child:not(.is-active) {
    opacity: 0;
    visibility: hidden;
  }

  .returns-policy-page__placeholder {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .returns-policy-page__item {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    .returns-policy-page__media {
      aspect-ratio: 3 / 4;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Returns policy page",
  "tag": "section",
  "class": "returns-policy-page-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Image collection",
      "info": "A random vertical product image from this collection is shown full-width at the bottom."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#fff7ec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#302118"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color",
      "default": "#7e736a"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider color",
      "default": "#d8cec3"
    }
  ],
  "presets": [
    {
      "name": "Returns policy page"
    }
  ]
}
{% endschema %}
