{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  class="section section--{{ section.settings.section_width }} spacing-style contact-page{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="contact-page__layout force-full-width">
    <div class="contact-page__content">
      <header class="contact-page__header">
        <h1 class="contact-page__title">
          {{ section.settings.heading | default: page.title | default: 'Contact' | escape }}
        </h1>
        {% if section.settings.subheading != blank %}
          <p class="contact-page__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </header>

      <div class="contact-page__form">
        {% content_for 'block', type: 'contact-form', id: 'contact-form' %}
      </div>
    </div>

    {%- comment -%} Desktop only: the source is attached by the script below at ≥990px so phones never download it. {%- endcomment -%}
    {% if section.settings.video_url != blank %}
      <div class="contact-page__media">
        <video
          class="contact-page__video"
          data-src="{{ section.settings.video_url | escape }}"
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>
      </div>
    {% endif %}
  </div>
</section>

{% if section.settings.video_url != blank %}
  <script>
    (() => {
      const video = document.currentScript.previousElementSibling?.querySelector('.contact-page__video');
      if (!video) return;
      const desktop = window.matchMedia('(min-width: 990px)');
      const sync = () => {
        if (desktop.matches) {
          if (!video.getAttribute('src')) {
            video.src = video.dataset.src;
            video.preload = 'auto';
          }
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      };
      sync();
      desktop.addEventListener('change', sync);
    })();
  </script>
{% endif %}

{% stylesheet %}
  .contact-page {
    width: 100%;
    min-height: calc(100dvh - var(--header-group-height, 0px));
  }

  .contact-page__layout {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 100%;
    min-height: calc(100dvh - var(--header-group-height, 0px));
  }

  .contact-page__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem var(--page-margin) 1.5rem;
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
    min-width: 0;
  }

  .contact-page__header {
    display: grid;
    gap: 0.75rem;
  }

  .contact-page__title,
  .contact-page__subheading {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact-page__title {
    color: #302118;
    font-weight: 300;
  }

  /* Body copy: sentence casing, same size and colour as the product description. */
  .contact-page__subheading {
    color: #4a4a4a;
    max-width: 36rem;
    font-size: 0.75rem;
    line-height: 1.7;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .contact-page__form {
    width: 100%;
    max-width: 28rem;
  }

  .contact-page__form .contact-form,
  .contact-page__form .contact-form.size-style {
    width: 100% !important;
    max-width: 100%;
  }

  .contact-page__media {
    display: none;
  }

  @media screen and (min-width: 990px) {
    /* Desktop: taller than one screen so the page (and the video beside the form) runs longer.
       svh never changes while scrolling, so the height can't jump mid-scroll. */
    .contact-page,
    .contact-page__layout,
    .contact-page__media {
      min-height: 120vh;
      min-height: 120svh;
    }

    .contact-page__content {
      margin-inline: 0;
      padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3.5rem);
    }

    /* Desktop: form on the left, video filling the right half. */
    .contact-page__layout:has(.contact-page__media) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .contact-page__layout:has(.contact-page__media) .contact-page__content {
      align-self: center;
    }

    .contact-page__media {
      position: relative;
      display: block;
      overflow: hidden;
      background: #ffffff;
    }

    .contact-page__video {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* Anchored near the top: cropping trims mostly the bottom, a little off the top. */
      object-position: center 20%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact page",
  "tag": "section",
  "class": "contact-page-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Have a question about an order, product, return, or store visit? Send us a message and we will get back to you as soon as possible."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "default": "https://cdn.shopify.com/videos/c/o/v/33b2207a552c4c76bf1de5fbd7e5b172.mov",
      "info": "Direct video link. Desktop only: plays muted on a loop to the right of the form. Hidden when empty."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Contact page",
      "category": "t:categories.forms",
      "blocks": {
        "contact-form": {
          "type": "contact-form",
          "static": true,
          "settings": {
            "width": "custom",
            "custom_width": 100,
            "width_mobile": "custom",
            "custom_width_mobile": 100,
            "input_style": "custom",
            "border_width": 0.5,
            "border_radius": 0
          },
          "blocks": {
            "submit-button": {
              "type": "contact-form-submit-button",
              "static": true,
              "settings": {
                "label": "Submit",
                "style_class": "button"
              }
            }
          }
        }
      }
    }
  ]
}
{% endschema %}
