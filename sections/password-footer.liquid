<div
  class="password-footer"
  data-testid="password-footer"
>
  <button
    class="button-unstyled password-footer__button"
    on:click="#password-form/showDialog"
  >
    {{ 'actions.enter_using_password' | t }}
  </button>
</div>

{% stylesheet %}
  .password-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0 var(--page-margin) 2rem;
    background: #fff7ec;
  }

  .password-footer__button {
    margin: 0;
    min-height: var(--minimum-touch-target);
    padding: 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #302118;
    background: transparent;
    cursor: pointer;
    text-decoration: none;
  }

  .password-footer__button:hover {
    color: rgb(48 33 24 / 0.62);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer_password",
  "class": "section-wrapper"
}
{% endschema %}
