{% liquid
  assign strip_color = section.settings.strip_color | default: '#5a5048'
%}

<div
  class="footer-accent-strip"
  style="
    --footer-accent-strip-color: {{ strip_color }};
    --footer-accent-strip-height: {{ section.settings.height }}px;
    --footer-accent-strip-mobile-height: {{ section.settings.mobile_height }}px;
    background-color: {{ strip_color }};
  "
  aria-hidden="true"
></div>

{% stylesheet %}
  .footer-accent-strip {
    display: block;
    width: 100%;
    height: var(--footer-accent-strip-height, 0.5px);
    background-color: var(--footer-accent-strip-color, #5a5048);
  }

  @media screen and (max-width: 749px) {
    .footer-accent-strip {
      height: var(--footer-accent-strip-mobile-height, 0.5px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer accent strip",
  "tag": "section",
  "class": "footer-accent-strip-section",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 0.5,
      "max": 24,
      "step": 0.5,
      "unit": "px",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 0.5,
      "max": 24,
      "step": 0.5,
      "unit": "px",
      "default": 0.5
    },
    {
      "type": "color",
      "id": "strip_color",
      "label": "Strip color",
      "default": "#5a5048"
    }
  ],
  "presets": [
    {
      "name": "Footer accent strip"
    }
  ]
}
{% endschema %}
