{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - The gap between the product card children (overrides block settings)
  @param {string} [product_view_context] - The context in which the product card is being rendered. Used for standard events.
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% style %}
  {% if request.visual_preview_mode %}
    product-card[data-product-transition] {
      width: 100%;
      min-width: 250px;
    }
  {% endif %}
{% endstyle %}

{% liquid
  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  assign product_card_id = 'product-card-link-' | append: block.id | append: '-' | append: product.id
  assign product_card_gap_value = product_card_gap | default: block_settings.product_card_gap
  capture product_titlecase
    render 'product-titlecase', title: product.title
  endcapture
  assign product_titlecase = product_titlecase | strip

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant

  if settings.transition_to_main_product
    assign featured_image = variant_to_link.featured_image
    if featured_image == blank
      assign featured_image = product.featured_media.preview_image
    endif

    if featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 500
    endif
  endif

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif

  assign is_on_sale = false
  if product.available and product.compare_at_price > product.price
    assign is_on_sale = true
  endif
  assign is_made_by_favrik = product.metafields.custom.made_by_favrik.value
  assign is_preorder = product.metafields['custom']['preorder'].value
  assign favrik_made_badge_color = shop.metafields['custom']['favrik_made_badge_color'].value
  assign sale_badge_color = shop.metafields['custom']['sale_badge_color'].value
  assign preorder_badge_color = shop.metafields['custom']['preorder_badge_color'].value

  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, text_color: block_settings.text_color, section_id: block.id
  endif
%}

<product-card
  class="product-card size-style"
  style="{% render 'size-style', settings: block_settings %}"
  data-product-id="{{ product.id }}"
  id="product-card-{{ block.id }}"
  {% if settings.transition_to_main_product %}
    data-product-transition="true"
    data-featured-media-url="{{ featured_media_url }}"
    on:click="/handleViewTransition"
  {% endif %}
  {{ block.shopify_attributes }}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
  {%- unless onboarding -%}
    {% # theme-check-disable-next-line UnknownFilter %}
    view-event-payload="{{ product | standard_event_data: 'view', context: product_view_context | escape }}"
  {%- endunless -%}
>
  <a
    id="{{ product_card_id | md5 }}"
    {% unless onboarding %}
      href="{{ variant_to_link.url }}"
    {% endunless %}
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">
      {{ product_titlecase }}
    </span>
  </a>
  {% if is_on_sale or is_made_by_favrik or is_preorder %}
    <div class="product-card__badges">
      {% if is_on_sale %}
        <span
          class="product-card__sale-badge"
          style="--sale-badge-color: {{ sale_badge_color }};"
        >
          SALE
        </span>
      {% endif %}
      {% if is_made_by_favrik %}
        <span
          class="product-card__made-by-favrik-badge"
          style="--favrik-made-badge-color: {{ favrik_made_badge_color }};"
        >
          FAVRIK MADE
        </span>
      {% endif %}
      {% if is_preorder %}
        <span
          class="product-card__preorder-badge"
          style="--preorder-badge-color: {{ preorder_badge_color }};"
        >
          PREORDER
        </span>
      {% endif %}
    </div>
  {% endif %}
  <div
    class="
      product-card__content
      layout-panel-flex
      layout-panel-flex--column
      product-grid__card
      spacing-style
      border-style
      gap-style
      {% if block_settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}
    "
    style="
      {% render 'border-override', settings: block_settings %}
      {% render 'layout-panel-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      {% render 'gap-style', value: product_card_gap_value, name: 'product-card-gap' %}
      --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-opacity: {% if has_mobile_quick_add %}1{% else %}0{% endif %};
      {% if block_settings.padding-inline-start > 0 %}--zoom-out-padding-inline-start: min(var(--padding-xs), {{ block_settings.padding-inline-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-inline-end > 0 %}--zoom-out-padding-inline-end: min(var(--padding-xs), {{ block_settings.padding-inline-end | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-start > 0 %}--zoom-out-padding-block-start: min(var(--padding-xs), {{ block_settings.padding-block-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-end > 0 %}--zoom-out-padding-block-end: min(var(--padding-xs), {{ block_settings.padding-block-end | times: 0.7}}px);{% endif %}
    "
  >
    {{ children }}
  </div>
</product-card>

{% stylesheet %}
  .resource-list--product-cards {
    --resource-list-column-gap: var(--product-card-grid-column-gap);
    --resource-list-row-gap: var(--product-card-grid-row-gap);
  }

  product-card .product-card__content {
    --product-card-color-row-height: 8px;
  }

  .product-card__badges {
    position: absolute;
    z-index: 3;
    top: 0.625rem;
    right: 0.625rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.375rem;
    pointer-events: none;
  }

  .product-card__sale-badge,
  .product-card__made-by-favrik-badge,
  .product-card__preorder-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 1.75rem;
    padding: 0.3rem 0.5rem;
    box-sizing: border-box;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-family: var(--font-body--family);
    font-size: var(--product-card-price-font-size, 0.6875rem);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .product-card__sale-badge {
    background: var(--sale-badge-color);
    color: #ffffff;
  }

  .product-card__made-by-favrik-badge {
    background: var(--favrik-made-badge-color);
    color: #fff7ec;
  }

  .product-card__preorder-badge {
    background: var(--preorder-badge-color);
    color: #ffffff;
  }

  product-card .product-card__content.border-style {
    --border-width: 0px;
    --border-style: none;
    --border-color: transparent;
    --border-radius: 0px;
    border: none;
    border-radius: 0;
    position: relative;
    background-color: transparent;
    padding-block: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  product-card .product-card__content.border-style > .card-gallery {
    background-color: #fff;
    flex: 0 0 auto;
  }

  product-card .card-gallery.border-style {
    --border-width: 0px;
    --border-style: none;
    border: none;
  }

  product-card .product-card__content.border-style:has(.product-card__meta) {
    background-color: transparent;
  }

  product-card .product-card__meta {
    background-color: transparent;
  }

  :is(.product-grid__item, .resource-list__item):has(.product-card__content.border-style) {
    margin-right: 0;
    margin-bottom: 0;
    position: relative;
    z-index: 0;
  }

  :is(.product-grid__item, .resource-list__item):has(.product-card:hover .product-card__content.border-style) {
    z-index: 1;
  }

  .product-card__content > a.contents > .text-block,
  .product-card__content > product-price {
    padding-inline: 0;
    box-sizing: border-box;
    max-width: 100%;
  }

  .product-card__content:not(:has(.product-card__meta)) > a.contents > .text-block {
    padding-block-start: var(--product-card-inline-padding);
  }

  .product-card__meta > a.contents > .text-block,
  .product-card__meta > product-price,
  .product-card__meta > .product-card-color-indicators {
    padding-inline: 0;
    box-sizing: border-box;
    max-width: 100%;
  }

  /* Use the color row itself as the single source of spacing below the gallery. */
  .product-card__content > .product-card-color-indicators {
    order: 0;
    justify-content: flex-start;
    margin-block-start: var(--product-card-inline-padding);
    margin-block-end: var(--product-card-color-row-gap);
    margin-inline: 0;
    width: 100%;
    padding-inline: 0;
  }

  .product-card__meta > .product-card-color-indicators {
    order: -1;
    justify-content: flex-start;
    margin-block-start: 0;
    margin-block-end: var(--product-card-color-row-gap);
  }

  .product-card__content > a.contents > .text-block > *,
  .product-card__meta > a.contents > .text-block > * {
    padding-inline-end: 0;
    max-width: 100%;
  }

  .product-card__content > a.contents > .text-block,
  .product-card__content > a.contents > .text-block :is(p, h1, h2, h3, h4, h5, h6),
  .product-card__meta > a.contents > .text-block,
  .product-card__meta > a.contents > .text-block :is(p, h1, h2, h3, h4, h5, h6) {
    font-size: var(--product-card-title-font-size);
    line-height: var(--product-card-text-line-height);
    font-weight: 400;
    color: #2e2e2e;
    overflow: visible;
    text-overflow: unset;
    white-space: normal;
    overflow-wrap: break-word;
    max-width: 100%;
    min-width: 0;
  }

  .product-card__content > a.contents,
  .product-card__meta > a.contents {
    min-width: 0;
    max-width: 100%;
  }

  .product-card__content > product-price,
  .product-card__content > product-price .price,
  .product-card__content > product-price .compare-at-price,
  .product-card__meta > product-price,
  .product-card__meta > product-price .price,
  .product-card__meta > product-price .compare-at-price {
    font-size: var(--product-card-price-font-size);
    font-weight: 400;
    line-height: var(--product-card-text-line-height);
    color: #2e2e2e;
  }

  .product-card__content > product-price .price-item--sale,
  .product-card__meta > product-price .price-item--sale {
    color: #c91f4a;
  }

  .product-card__content > product-price .compare-at-price,
  .product-card__meta > product-price .compare-at-price {
    color: rgb(var(--color-foreground-rgb) / 0.4);
    font-weight: 300;
  }

  .product-card__content > product-price .price-container--product-card,
  .product-card__meta > product-price .price-container--product-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--product-card-title-price-gap);
    width: 100%;
  }

  .product-card__content > product-price .product-card__sold-out,
  .product-card__meta > product-price .product-card__sold-out,
  product-card .product-card__sold-out {
    display: block;
    font-size: var(--product-card-meta-font-size);
    font-weight: 400;
    line-height: var(--product-card-text-line-height);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #c91f4a;
  }

  product-card .product-card__sold-out:not(.product-card__sold-out--placeholder) {
    margin-block-start: var(--product-card-title-price-gap);
  }

  .product-card__sold-out--placeholder {
    visibility: hidden;
  }

  .product-card__content > a.contents > .text-block,
  .product-card__meta > a.contents > .text-block {
    padding-block-end: 0;
    border: none;
  }

  /* Beat base.css `.product-grid__card .contents:has(.text-block) + product-price`
     which applies a negative margin that cancels card gap. */
  product-card .product-grid__card .contents:has(.text-block) + product-price,
  product-card .product-card__meta > .contents:has(.text-block) + product-price,
  .product-card__content > a.contents + product-price,
  .product-card__meta > a.contents + product-price {
    margin-block-start: var(--product-card-title-price-gap);
  }

  .product-card__content > product-price,
  .product-card__meta > product-price {
    border: none;
  }

  .product-card__meta > product-price {
    padding-block-end: 0;
  }

  .product-card__content:not(:has(.product-card__meta)) > product-price {
    padding-block-end: 0;
  }

  .product-card__meta {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 0;
    background-color: transparent;
    padding-block-start: var(--product-card-inline-padding);
    padding-block-end: 0;
    padding-inline: 0;
    position: relative;
  }

  .product-card__meta > a.contents > .text-block {
    padding-block-start: 0;
  }

  .product-card__meta > product-price {
    position: relative;
    z-index: 1;
  }

  .product-card__content:not(:has(.product-card__meta)) > a.contents + product-price {
    margin-block-start: var(--product-card-title-price-gap);
  }

  .product-card__content:not(:has(.product-card__meta)) > .product-card-color-indicators {
    justify-content: flex-start;
    margin-inline: 0;
    width: 100%;
    margin-block-start: var(--product-card-inline-padding);
    margin-block-end: var(--product-card-color-row-gap);
  }

  :is(.product-grid__item, .resource-list__item) product-card .product-card__content.product-grid__card {
    padding-block: 0;
  }

  /* Meta/title padding owns spacing — collapse layout gap so top matches sides/bottom */
  product-card .product-card__content.layout-panel-flex {
    gap: 0;
    row-gap: 0;
    --gap: 0px;
    --product-card-gap: 0px;
  }

  product-card .product-card__content.layout-panel-flex > .card-gallery {
    margin-block-end: 0;
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    product-card .product-card__sold-out:not(.product-card__sold-out--placeholder) {
      margin-block-start: 8px;
    }

    .product-card__badges {
      top: 0.5rem;
      right: 0.5rem;
      gap: 0.3rem;
    }

    .product-card__sale-badge,
    .product-card__made-by-favrik-badge,
    .product-card__preorder-badge {
      min-height: 1.125rem;
      padding: 0.1rem 0.35rem;
    }

    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }

    /* Full-width collection grids pull galleries with negative margin, which
       leaves a gap inside the card frame. Keep images flush to the border. */
    :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
      product-card
      .card-gallery {
      margin-inline-start: 0;
      margin-inline-end: 0;
    }

    product-card .card-gallery {
      overflow: hidden;
    }

    product-card .card-gallery
      :is(
        slideshow-component,
        slideshow-container,
        slideshow-slides,
        slideshow-slide,
        .product-media-container,
        .product-media
      ) {
      width: 100%;
      height: 100%;
      min-height: 0;
    }

    product-card .card-gallery .product-media {
      position: relative;
      aspect-ratio: auto;
    }

    product-card .card-gallery :is(.product-media__image, img):not(.product-card-gallery__coming-soon-logo) {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
    }
  }
{% endstylesheet %}
