{% # theme-check-disable RemoteAsset %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Nanum+Gothic:wght@400;700&family=Poppins:wght@400;500;600;700&display=swap"
  rel="stylesheet"
>
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&text=%240123456789.,%25%2B-%2F%C2%A2%C2%A3%C2%A5%E2%82%A9%E2%82%AC&display=swap"
  rel="stylesheet"
>
{% # theme-check-enable RemoteAsset %}

{% style %}
  /*
   * Metric-matched stand-in for Poppins while the web font downloads. Arial is scaled
   * and spaced to occupy the same box as Poppins, so the font-display: swap changes
   * glyph shapes only, not line lengths or heights (no layout shift).
   */
  @font-face {
    font-family: 'Poppins Fallback';
    src: local('Arial'), local('ArialMT');
    size-adjust: 112.16%;
    ascent-override: 93.62%;
    descent-override: 31.21%;
    line-gap-override: 8.92%;
  }
{% endstyle %}

{%- liquid
  assign font_setting_ids = 'type_body_font,type_subheading_font,type_heading_font,type_accent_font' | split: ','
  assign preloaded_font_urls = '' | split: ','

  for font_setting_id in font_setting_ids
    assign configured_font = settings[font_setting_id]
    unless configured_font == blank or configured_font.system?
      assign configured_font_url = configured_font | font_url
      unless preloaded_font_urls contains configured_font_url
        echo configured_font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low'
        assign current_font_urls = configured_font_url | split: ','
        assign preloaded_font_urls = preloaded_font_urls | concat: current_font_urls
      endunless
    endunless
  endfor
-%}
