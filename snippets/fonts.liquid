{% # theme-check-disable RemoteAsset %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Nanum+Gothic:wght@400;700&family=Poppins:wght@400;500;600;700&display=swap"
  rel="stylesheet"
>
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&text=%240123456789.,%25%2B-%2F%C2%A2%C2%A3%C2%A5%E2%82%A9%E2%82%AC&display=swap"
  rel="stylesheet"
>
{% # theme-check-enable RemoteAsset %}

{% style %}
  /*
   * Metric-matched stand-in for Poppins while the web font downloads. Arial is scaled
   * and spaced to occupy the same box as Poppins, so the font-display: swap changes
   * glyph shapes only, not line lengths or heights (no layout shift).
   */
  @font-face {
    font-family: 'Poppins Fallback';
    src: local('Arial'), local('ArialMT');
    size-adjust: 112.16%;
    ascent-override: 93.62%;
    descent-override: 31.21%;
    line-gap-override: 8.92%;
  }
{% endstyle %}

{%- unless settings.type_body_font.system? -%}
  {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}
{%- unless settings.type_subheading_font.system? -%}
  {{ settings.type_subheading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}
{%- unless settings.type_heading_font.system? -%}
  {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}
{%- unless settings.type_accent_font.system? -%}
  {{ settings.type_accent_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}
