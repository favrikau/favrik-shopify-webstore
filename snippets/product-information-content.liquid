{% doc %}
  Product Information Content

  Renders the product information layout with media gallery and product details.
  Used by both product-information and featured-product-information sections.

  @param {product} product - Product object
  @param {string} section_id - Unique section ID
  @param {object} settings - Section settings object
  @param {string} media_gallery - Captured HTML for the product media gallery block
  @param {string} product_details - Captured HTML for the product details block
  @param {string} additional_blocks - Captured HTML for additional section blocks

  @example
  {% capture media_gallery %}
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery', closest.product: product %}
  {% endcapture %}

  {% capture product_details %}
    {% content_for 'block', type: '_product-details', id: 'product-details', closest.product: product %}
  {% endcapture %}

  {% capture additional_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'product-information-content',
    product: product,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
{% enddoc %}

{% liquid
  # Determine render order based on media position
  if settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  # Always keep the left media column — gallery shows a placeholder when empty
  assign product_has_media = true

  # Build product grid class
  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  # Determine content width
  case settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase

%}

{% liquid
  if settings.background_color != blank
    render 'contrast-override', background_color: settings.background_color, section_id: section_id
  endif
%}

<div
  class="section-background{% if settings.background_color != blank %} color-custom-{{ section_id }}{% endif %}"
></div>

{% if request.page_type == 'product' %}
  {% render 'product-delivery-banner' %}
{% endif %}

<div
  class="product-information product-page-typography section section--{{ content_width }} spacing-style{% if settings.background_color != blank %} color-custom-{{ section_id }}{% endif %} relative"
  style="{% render 'spacing-style', settings: settings %} --gap: {{ settings.gap }}px;"
  data-testid="product-information"
>
  {% if settings.desktop_media_position == 'left' and product_has_media and request.page_type == 'product' %}
    {% assign product_href = '#ProductInformation-' | append: section_id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}

  <product-component
    class="{{ product_grid_class }}"
    data-product-grid-content
    {% # theme-check-disable UnknownFilter %}
    view-event-payload="{{ product | standard_event_data: 'view' | escape }}"
    {% # theme-check-enable UnknownFilter %}
  >
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="product-information__media"
        data-testid="product-information-media"
      >
        {{ media_gallery }}
      </div>
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {% if request.page_type == 'product' %}
          <div class="product-information__details-stack">
            {{ product_details }}
          </div>
        {% else %}
          {{ product_details }}
        {% endif %}
      {% endif %}
    {% endfor %}
  </product-component>

  {{ additional_blocks }}
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details,
  .product-information__details-stack {
    order: 1;
  }

  .product-information__details-stack {
    display: flex;
    flex-direction: column;
    width: 0;
    min-width: 100%;
  }

  .product-information__details-stack:has(.product-breadcrumbs) .product-details {
    --padding-block-start: 0px;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  .product-information__media .product-media-gallery__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: min(70vh, 44rem);
    aspect-ratio: var(--product-card-media-ratio, 2 / 3);
    overflow: hidden;
  }

  .product-information__media .product-media-gallery__coming-soon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: inherit;
    background: #4a3728;
    color: #ffffff;
  }

  .product-information__media .product-media-gallery__coming-soon-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    height: 100%;
    padding: 2rem;
    box-sizing: border-box;
  }

  .product-information__media .product-media-gallery__coming-soon-logo {
    width: min(7.5rem, 28%);
    max-width: 7.5rem;
    height: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .product-information__media .product-media-gallery__coming-soon-text {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    color: #ffffff;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information__media {
      grid-column: 1 / -1;
    }

    .product-details,
    .product-information__details-stack {
      grid-column: 2 / 3;
    }

  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-column: 2;
    }

    /* Product hero stays one viewport tall so page scroll reaches sections below without
       first scrolling through every product image. Both panes scroll independently. */
    .product-information__grid:not(.product-information--media-none) {
      --product-pane-height: calc(100dvh - var(--header-group-height, 0px));

      height: var(--product-pane-height);
      max-height: var(--product-pane-height);
      min-height: 0;
      align-items: stretch;
    }

    .product-information__grid:not(.product-information--media-none) > .product-information__media,
    .product-information__grid:not(.product-information--media-none) > .product-information__details-stack,
    .product-information__grid:not(.product-information--media-none) > .product-details {
      height: 100%;
      min-height: 0;
      max-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior-y: contain;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .product-information__grid:not(.product-information--media-none) > .product-information__media::-webkit-scrollbar,
    .product-information__grid:not(.product-information--media-none) > .product-information__details-stack::-webkit-scrollbar,
    .product-information__grid:not(.product-information--media-none) > .product-details::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    .product-information__grid:not(.product-information--media-none) > .product-information__details-stack {
      overflow: hidden;
    }

    .product-information__grid:not(.product-information--media-none)
      > .product-information__details-stack
      > .product-details {
      height: 100%;
      min-height: 0;
      max-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior-y: contain;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .product-information__grid:not(.product-information--media-none)
      > .product-information__details-stack
      > .product-details::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    .product-information__grid:not(.product-information--media-none) .product-information__media media-gallery,
    .product-information__grid:not(.product-information--media-none) .product-information__media .media-gallery__grid {
      width: 100%;
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none {
      .product-details,
      .product-information__details-stack {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(.product-information--media-none) {
      /* Media on the left side */
      &.product-information--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .product-information__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .product-details,
        .product-information__details-stack {
          padding-left: calc(var(--gap, 0) / 2);
        }

        .product-information__details-stack .product-details {
          padding-left: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details,
        .product-information__details-stack {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        .product-information__details-stack .product-details {
          padding-right: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Favrik product split: 61.8% imagery / 38.2% information */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          minmax(0, 61.8fr)
          minmax(0, 38.2fr);
        column-gap: 0;

        &.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 2;
            padding-right: 0;
            width: auto;
            min-width: 0;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 2;
            }
          }

          .product-details,
          .product-information__details-stack {
            grid-column: 2 / -1;
            padding-left: 0;
            padding-right: 0;
            width: auto;
            min-width: 0;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 2 / -1;
            padding-left: 0;
            width: auto;
            min-width: 0;

            &:has(.media-gallery--extend) {
              grid-column: 2 / -1;
            }
          }

          .product-details,
          .product-information__details-stack {
            grid-column: 1 / 2;
            padding-left: 0;
            padding-right: 0;
            width: auto;
            min-width: 0;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(.product-information--media-none) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details,
        &.product-information--media-left .product-information__details-stack {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details,
        &.product-information--media-right .product-information__details-stack {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details,
          .product-information__details-stack {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details,
          .product-information__details-stack {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  /* Wider sidebar for large screens */
  @media screen and (min-width: 1200px) {
    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-left {
      grid-template-columns: 2fr 1fr;
    }

    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-right {
      grid-template-columns: 1fr 2fr;
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    --details-max-width: var(--sidebar-width);
    max-width: var(--details-max-width);
  }

  @media screen and (min-width: 1600px) {
    .product-information__grid--limit-details .product-details > .group-block {
      --details-max-width: 32rem;
    }
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }

  @media screen and (min-width: 750px) {
    .product-information .product-details {
      --style-border-radius-buttons-primary: 4px;
      --style-border-radius-buttons-secondary: 4px;
      --style-border-radius-inputs: 4px;
      --style-border-radius-pills: 4px;
    }
  }

  .product-information .media-gallery__grid {
    gap: 0;
  }

  /* Prevent any full-bleed / carousel overflow from enabling page-level horizontal scroll. */
  @media screen and (min-width: 750px) {
    .product-information,
    .product-information__grid {
      max-width: 100%;
      min-width: 0;
      overflow-x: clip;
    }
  }

  .product-breadcrumbs {
    --product-breadcrumb-color: #b5aaa0;
    --product-breadcrumb-color-current: #a3988c;
    --product-breadcrumb-color-hover: #8f857c;

    margin: 0;
    padding-block-start: 24px;
    padding-block-end: var(--padding-sm);
  }

  .product-breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-paragraph-small--size);
    line-height: var(--font-paragraph-small--line-height);
    color: var(--product-breadcrumb-color);
  }

  .product-breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .product-breadcrumbs__link {
    color: inherit;
    text-decoration: none;
  }

  .product-breadcrumbs__link:hover {
    color: var(--product-breadcrumb-color-hover);
    text-decoration: underline;
  }

  .product-breadcrumbs__current {
    color: var(--product-breadcrumb-color-current);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-breadcrumbs__separator {
    color: var(--product-breadcrumb-color);
  }

  @media screen and (max-width: 749px) {
    .product-breadcrumbs {
      padding-block-start: var(--padding-md);
    }
  }

  .product-information .product-section-heading,
  .product-information .product-shipping-returns .details__header.product-section-heading,
  .product-information .product-details .text-block--text_description_heading.h5 :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--font-body--family);
    font-size: var(--font-body--size);
    line-height: var(--font-body--line-height);
    font-weight: var(--font-body--weight);
    text-transform: none;
  }

  /* Right column: bordered sections — full width, collapsed shared edges */
  .product-information .product-details > .group-block > .group-block-content {
    --product-details-section-border-color: rgb(48 33 24 / 0.22);
    --product-details-section-border-width: 0.5px;
    --product-details-section-padding: clamp(1.5rem, 2.25vw, 2.25rem) clamp(1.5rem, 3vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    height: 100%;
    min-height: inherit;
    align-items: stretch;
  }

  .product-information .product-details > .group-block > .group-block-content > .view-product-title {
    border: none;
    padding: 0;
  }

  .product-information .product-details > .group-block > .group-block-content > *:not(.divider):not(.view-product-title) {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    align-self: stretch;
    padding: var(--product-details-section-padding);
    border-style: solid;
    border-color: var(--product-details-section-border-color);
    /* Shared edges: no top border; first visible section adds it below */
    border-width: 0 var(--product-details-section-border-width) var(--product-details-section-border-width);
  }

  @media screen and (min-width: 750px) {
    .product-information .product-details > .group-block > .group-block-content > *:not(.divider):not(.view-product-title) {
      /* Share all unused pane height between sections without constraining content. */
      flex: 1 0 auto;
    }
  }

  .product-information .product-details > .group-block > .group-block-content > .view-product-title + *:not(.divider),
  .product-information .product-details > .group-block > .group-block-content > *:not(.divider):not(.view-product-title):first-child {
    border-top-width: var(--product-details-section-border-width);
  }

  .product-information .product-details > .group-block > .group-block-content > .divider {
    display: none;
  }

  /* Nested groups fill their bordered section */
  .product-information .product-details > .group-block > .group-block-content > .group-block,
  .product-information .product-details > .group-block > .group-block-content > .group-block > .group-block-content {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    height: auto;
    align-self: stretch;
    gap: 0.875rem;
  }

  .product-information .product-details .variant-picker__form {
    display: grid;
    gap: 1.5rem;
  }

  /* Collapse empty variant-picker slots so products without size/color choices
     don't leave a padded bordered gap in the details column. */
  .product-information
    .product-details
    > .group-block
    > .group-block-content
    > *:has(variant-picker):not(:has(.variant-option)),
  .product-information
    .product-details
    > .group-block
    > .group-block-content
    > variant-picker:not(:has(.variant-option)) {
    display: none;
    padding: 0;
    border: none;
    flex: none;
    min-height: 0;
  }

  .product-information .product-details .product-form-buttons {
    gap: 0.875rem;
  }

  .product-information .product-details .rte {
    line-height: 1.65;
  }

  .product-information .product-details .product-shipping-returns__content {
    padding-block-start: 1.25rem;
    line-height: 1.65;
  }

  @media screen and (max-width: 749px) {
    .product-information .product-details > .group-block > .group-block-content {
      --product-details-section-padding: 1.25rem;
    }
  }

  /* Title + price: same body size; title in all caps */
  .product-information .product-details .text-block--text_xrnftG,
  .product-information .product-details .text-block--text_xrnftG :is(h1, h2, h3, h4, h5, h6),
  .product-information .product-details product-price.text-block,
  .product-information .product-details product-price.text-block :is(.price, .compare-at-price, .unit-price) {
    font-family: var(--font-body--family);
    font-size: var(--font-paragraph--size, 1rem);
    line-height: var(--font-paragraph--line-height, var(--font-body--line-height));
    font-weight: var(--font-body--weight);
  }

  .product-information .product-details .text-block--text_xrnftG,
  .product-information .product-details .text-block--text_xrnftG :is(h1, h2, h3, h4, h5, h6) {
    --font-weight: 600;
    font-weight: 600;
    text-transform: uppercase;
  }
{% endstylesheet %}
