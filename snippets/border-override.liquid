{%- comment -%}
  Renders border override CSS.
  All visible borders use a consistent 0.5px hairline weight.
{%- endcomment -%}

{% liquid
  assign border_width_value = 0
  if settings.border_width > 0
    assign border_width_value = 0.5
  endif
%}
--border-width: {{ border_width_value }}px; --border-style: {{ settings.border }}; --border-color:
{% if settings.border_color != blank -%}
  rgb({{ settings.border_color.rgba }})
{%- else -%}
  rgb(var(--color-border-rgb) / {{ settings.border_opacity | divided_by: 100.0 }})
{%- endif -%}
; --border-radius: {{ settings.border_radius }}px; {% if settings.border_radius > 0 %} overflow: hidden; {% endif %}
