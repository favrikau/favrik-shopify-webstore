{% doc %}
  Header SKU search — icon toggle opens a transparent search layer over the page blur.

  @param {object} section - Header section for unique IDs
{% enddoc %}

{% render 'search-autocomplete-styles' %}

{% liquid
  assign header_search_id = 'HeaderSkuSearch-' | append: section.id
%}

<div class="header-sku-search" data-header-sku-search>
  <button
    type="button"
    class="header-actions__action header-actions__search-toggle button-unstyled"
    aria-label="{{ 'content.search_input_label' | t }}"
    aria-expanded="false"
    aria-controls="{{ header_search_id }}-panel"
    data-header-sku-search-toggle
  >
    <span class="svg-wrapper" aria-hidden="true">
      {{ 'icon-search.svg' | inline_asset_content }}
    </span>
  </button>

  <div
    id="{{ header_search_id }}-panel"
    class="header-sku-search__panel"
    hidden
    data-header-sku-search-panel
  >
    <div class="facets__sku-search header-sku-search__form" data-collection-sku-search data-placeholder-logo="{{ 'favrik_logo.png' | asset_url }}">
      <label class="visually-hidden" for="{{ header_search_id }}-input">
        {{ 'content.search_input_label' | t }}
      </label>
      <input
        id="{{ header_search_id }}-input"
        class="facets__sku-search-input header-sku-search__input"
        type="search"
        placeholder="Search by name or SKU"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-controls="{{ header_search_id }}-results"
        aria-expanded="false"
        data-collection-sku-search-input
      >
      <div
        id="{{ header_search_id }}-results"
        class="facets__sku-search-results header-sku-search__results"
        role="listbox"
        hidden
        data-collection-sku-search-results
      ></div>
      {% paginate collections.all.products by 250 %}
        {% render 'sku-search-product-data', products: collections.all.products %}
      {% endpaginate %}
    </div>
  </div>
</div>

<script
  type="module"
  src="{{ 'header-sku-search.js' | asset_url }}"
  fetchpriority="low"
></script>

{% stylesheet %}
  /* Match menu-drawer: layout containment clips fixed overlays that leave the header. */
  .header:has(.header-sku-search.is-open) {
    contain: style;
  }

  .header-sku-search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header-actions__search-toggle {
    color: var(--color-foreground);
  }

  /* Mounted on body so header `contain: layout` cannot collapse it. */
  .header-sku-search-backdrop {
    position: fixed;
    /* Match sticky header `top: -1px` so the blur sits flush — no cream gap */
    top: calc(var(--header-height, 0px) - 1px);
    right: 0;
    bottom: 0;
    left: 0;
    width: auto;
    z-index: calc(var(--layer-menu-drawer) - 1);
    background: rgb(48 33 24 / 0.42);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.32s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1)),
      visibility 0.32s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1));
  }

  .header-sku-search-backdrop.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .header-sku-search__panel {
    position: fixed;
    top: calc(var(--header-height, 0px) - 1px);
    right: 0;
    left: 0;
    z-index: var(--layer-menu-drawer);
    width: auto;
    max-width: none;
    padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 4vw, 3rem) 1.5rem;
    background: transparent;
    border: 0;
    box-shadow: none;
    pointer-events: none;
  }

  .header-sku-search__form {
    position: relative;
    display: block;
    width: min(36rem, 100%);
    margin-inline-start: auto;
    pointer-events: auto;
  }

  .header-sku-search__input,
  .header-sku-search .facets__sku-search-input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.65rem 0;
    border: 0;
    border-bottom: 0.5px solid rgb(255 255 255 / 0.85);
    border-radius: 0;
    background: transparent;
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    outline: none;
    box-shadow: none;
    caret-color: #ffffff;
  }

  .header-sku-search__input::placeholder,
  .header-sku-search .facets__sku-search-input::placeholder {
    color: rgb(255 255 255 / 0.55);
    text-transform: uppercase;
  }

  .header-sku-search__input:focus,
  .header-sku-search .facets__sku-search-input:focus {
    border-color: #ffffff;
    background: transparent;
  }

  .header-sku-search__input::-webkit-search-cancel-button {
    filter: invert(1);
  }

  .header-sku-search__results,
  .header-sku-search .facets__sku-search-results {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 1rem);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    max-height: min(32rem, calc(100dvh - var(--header-height, 0px) - 7rem));
    overflow-x: hidden;
    overflow-y: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    background-color: transparent;
    box-shadow: none;
    opacity: 1;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    scrollbar-width: none !important;
    scrollbar-color: transparent transparent;
    -ms-overflow-style: none;
  }

  .header-sku-search__results::-webkit-scrollbar,
  .header-sku-search .facets__sku-search-results::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    background: transparent !important;
  }

  .header-sku-search__results::-webkit-scrollbar-track,
  .header-sku-search .facets__sku-search-results::-webkit-scrollbar-track,
  .header-sku-search__results::-webkit-scrollbar-thumb,
  .header-sku-search .facets__sku-search-results::-webkit-scrollbar-thumb {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    background: transparent !important;
    border: 0 !important;
  }

  .header-sku-search .facets__sku-search-option {
    display: flex;
    align-items: stretch;
    gap: 0;
    width: 100%;
    min-height: 5.25rem;
    margin: 0;
    padding: 0 !important;
    overflow: hidden;
    appearance: none;
    -webkit-appearance: none;
    border: 0.5px solid rgb(255 255 255 / 0.28);
    border-radius: 0;
    background: transparent;
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s var(--ease-out-cubic, ease), border-color 0.2s var(--ease-out-cubic, ease);
  }

  .header-sku-search .facets__sku-search-option:last-child {
    border-bottom: 0.5px solid rgb(255 255 255 / 0.28);
  }

  .header-sku-search .facets__sku-search-option:is(:hover, :focus-visible),
  .header-sku-search .facets__sku-search-option.is-active {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.45);
    outline: none;
  }

  .header-sku-search .facets__sku-search-option-image {
    position: relative;
    display: block;
    flex: 0 0 4.25rem;
    width: 4.25rem;
    min-width: 4.25rem;
    max-width: 4.25rem;
    height: auto;
    min-height: 5.25rem;
    align-self: stretch;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-inline-end: 0.5px solid rgb(255 255 255 / 0.18);
    background: rgb(48 33 24 / 0.35);
  }

  .header-sku-search .facets__sku-search-option-image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #4a3728;
    border-inline-end-color: rgb(255 255 255 / 0.12);
  }

  .header-sku-search .facets__sku-search-option-image:not(.facets__sku-search-option-image--placeholder) img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    margin: 0;
  }

  .header-sku-search .facets__sku-search-option-placeholder-logo {
    position: static;
    width: 58%;
    max-width: 2.35rem;
    height: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .header-sku-search .facets__sku-search-option-content {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: center;
    gap: 0.38rem;
    padding: 0.7rem;
  }

  .header-sku-search .facets__sku-search-option-title {
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .header-sku-search .facets__sku-search-option-match,
  .header-sku-search .facets__sku-search-option-price {
    color: rgb(255 255 255 / 0.7);
  }

  @media screen and (max-width: 749px) {
    .header-sku-search__form {
      width: 100%;
      margin-inline: 0;
    }
  }
{% endstylesheet %}
