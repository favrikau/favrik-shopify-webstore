{% doc %}
  Header Actions Component

  Renders the header actions.

  @param {object} [section] - The section object providing settings such as actions_font.
  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [display_style] - Controls display mode for header actions: 'icon' or 'text'.
  @param {string} [customer_account_menu] - The menu handle passed to the shopify-account component.

  @example
  {% render 'header-actions', section: section %}
{% enddoc %}

<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>

{% capture cart_icon %}
  <cart-icon
    class="header-actions__cart-icon{% if display_style == 'text' %} header-actions__cart-icon--text{% endif %}{% unless cart == empty %} header-actions__cart-icon--has-cart{% endunless %}"
    data-testid="cart-icon"
  >
    <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
      {{ 'content.cart_title' | t }}
    </span>

    <span
      class="svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}"
      aria-hidden="true"
    >
      {{ 'icon-cart.svg' | inline_asset_content }}
    </span>

    {% render 'cart-bubble', limit: 100 %}
  </cart-icon>
{% endcapture %}

{% capture account_icon %}
  {{ 'icon-account.svg' | inline_asset_content }}
{% endcapture %}

<header-actions
  {% if display_style == 'text' %}
    class="header-actions--text"
  {% endif %}
  {{- block.shopify_attributes -}}
>
  {% render 'header-sku-search', section: section %}

  <a
    href="https://www.instagram.com/favrik_/?hl=en"
    class="header-actions__action header-actions__instagram mobile:hidden"
    aria-label="Instagram"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="svg-wrapper" aria-hidden="true">
      <svg
        viewBox="0 0 20 20"
        fill="none"
        focusable="false"
        class="icon icon-instagram"
        aria-hidden="true"
      >
        <rect
          x="3.25"
          y="3.25"
          width="13.5"
          height="13.5"
          rx="3.75"
          ry="3.75"
          stroke="currentColor"
          stroke-width="var(--icon-stroke-width)"
        />
        <circle
          cx="10"
          cy="10"
          r="3.35"
          stroke="currentColor"
          stroke-width="var(--icon-stroke-width)"
        />
        <circle
          cx="14.35"
          cy="5.65"
          r="0.85"
          fill="currentColor"
        />
      </svg>
    </span>
  </a>

  {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
    <button
      class="header-actions__action button-unstyled{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      on:click="#cart-drawer/toggle"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="cart-drawer"
      aria-label="{{ 'accessibility.cart' | t }}"
      aria-describedby="cart-bubble-text"
      data-testid="cart-drawer-trigger"
    >
      {{ cart_icon }}
    </button>
  {% else %}
    <a
      href="{{ routes.cart_url }}"
      class="header-actions__action action__cart{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'accessibility.cart' | t }}"
      aria-describedby="cart-bubble-text"
    >
      {{ cart_icon }}
    </a>
  {% endif %}

  {% if shop.customer_accounts_enabled %}
    {% liquid
      assign account_actions_style = ''
      if display_style == 'text' and section
        assign actions_font = section.settings.actions_font | default: 'body'
        assign font_obj = settings.type_heading_font
        case actions_font
          when 'body'
            assign font_obj = settings.type_body_font
          when 'subheading'
            assign font_obj = settings.type_subheading_font
          when 'accent'
            assign font_obj = settings.type_accent_font
        endcase
        assign font_family = font_obj.family | append: ', ' | append: font_obj.fallback_families
        assign font_family_safe = font_family | replace: '"', "'"
        assign account_actions_style = '--header-actions-font-family: ' | append: font_family_safe | append: '; --header-actions-font-weight: ' | append: font_obj.weight | append: ';'
      endif
    %}
    <div
      class="account-button header-actions__action{% if display_style == 'text' %} account-button--text{% endif %} color-custom-popover"
    >
      <shopify-account
        menu="{{ customer_account_menu }}"
        {% if account_actions_style != blank %}
          style="{{ account_actions_style }}"
        {% endif %}
      >
        {% if customer %}
          <div class="account-button__fallback"></div>
        {% else %}
          <span
            slot="signed-out-avatar"
            class="account-button__text header-actions__text-style {% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}"
          >
            Log in
          </span>

          <span
            slot="signed-out-avatar"
            class="svg-wrapper account-button__icon{% if display_style != 'icon' %} desktop:hidden{% endif %}"
            aria-hidden="true"
          >
            {{ account_icon }}
          </span>
        {% endif %}
      </shopify-account>
      {%- comment -%}
        <shopify-account> draws its avatar and dropdown inside an (open) shadow DOM, and the sign-in
        form inside it (<shopify-login-form>) has a shadow DOM of its own. Sizes are set on inner
        elements and the site's own type rules (incl. the global letter-spacing) can't reach in, so
        add a stylesheet inside each shadow root (adoptedStyleSheets survives re-renders) to:
        - paint the signed-in avatar's ring in the brand red (#8a0b10) instead of Shop purple;
        - match the header: titles and menu items 13px uppercase, weight 300, the site's letter
          spacing; buttons and body text (email field, "Email me with news and offers") 11px —
          the email field stays 16px on phones so iOS doesn't zoom in on tap, as elsewhere on site;
        - on desktop, line the dropdown's right edge up with the account icon.
        The dropdown's top is set to the bottom of the header (banner + bar) each time it opens.
      {%- endcomment -%}
      <script>
        (() => {
          const SITE_TYPE = `
            #shopify-element-wrapper,
            #shopify-element-wrapper * {
              letter-spacing: var(--letter-spacing-global, 0.02em) !important;
            }
          `;
          const ACCOUNT_CSS = `${SITE_TYPE}
            #shopify-element-wrapper {
              --shop-brand-color: #8a0b10 !important;
              --font-size-xs: 0.6875rem;
              --font-size-sm: 0.8125rem;
              --font-size-md: 0.8125rem;
            }
            .account__heading {
              font-weight: 300;
            }
            .account__email {
              font-size: 0.6875rem;
            }
            .account__item {
              font-weight: 300;
              text-transform: uppercase;
            }
            @media (min-width: 751px) {
              .dialog {
                inset-inline-end: var(--favrik-account-right, var(--app-page-spacing)) !important;
              }
            }
          `;
          const LOGIN_FORM_CSS = `${SITE_TYPE}
            #shopify-element-wrapper {
              --font-size-xs: 0.6875rem;
              --font-size-sm: 0.6875rem;
            }
            @media (max-width: 749px) {
              .login-form__email-input {
                font-size: 16px;
              }
            }
          `;

          /** Add `css` inside a shadow root, once. */
          const addSheet = (root, css) => {
            if (!root || root.__favrikStyled) return false;
            try {
              const sheet = new CSSStyleSheet();
              sheet.replaceSync(css);
              root.adoptedStyleSheets = [...root.adoptedStyleSheets, sheet];
            } catch (error) {
              const style = document.createElement('style');
              style.textContent = css;
              root.append(style);
            }
            root.__favrikStyled = true;
            return true;
          };

          /** Style any sign-in forms inside `root`, looking through nested shadow roots. */
          const styleLoginForms = (root) => {
            if (!root) return;
            root.querySelectorAll('*').forEach((el) => {
              if (!el.shadowRoot) return;
              if (el.localName === 'shopify-login-form') addSheet(el.shadowRoot, LOGIN_FORM_CSS);
              styleLoginForms(el.shadowRoot);
            });
          };

          const apply = (account) => addSheet(account.shadowRoot, ACCOUNT_CSS);

          /** Dropdown top = bottom of the header (banner + bar); right edge = the account icon's. */
          const placeDropdown = (account) => {
            const headerSection = document.querySelector('.header-section');
            const top = headerSection ? Math.max(0, Math.round(headerSection.getBoundingClientRect().bottom)) : 0;
            const button = account.closest('.account-button') || account;
            const right = Math.max(0, Math.round(document.documentElement.clientWidth - button.getBoundingClientRect().right));
            account.style.setProperty('--shopify-account-dialog-position-top', `${top}px`);
            account.style.setProperty('--favrik-account-right', `${right}px`);
          };

          /** The sign-in form loads when the dropdown opens — style it as soon as it appears. */
          const watchLoginForm = (account) => {
            styleLoginForms(account.shadowRoot);
            let tries = 0;
            const timer = setInterval(() => {
              styleLoginForms(account.shadowRoot);
              if (++tries > 40) clearInterval(timer);
            }, 150);
          };

          document.querySelectorAll('shopify-account').forEach((account) => {
            // Capture runs before the component's own click handler opens the dropdown.
            ['pointerdown', 'click', 'keydown'].forEach((type) =>
              account.addEventListener(type, () => placeDropdown(account), { capture: true })
            );
            account.addEventListener('click', () => watchLoginForm(account));
            window.addEventListener('resize', () => placeDropdown(account), { passive: true });
            placeDropdown(account);
          });

          customElements.whenDefined('shopify-account').then(() => {
            document.querySelectorAll('shopify-account').forEach((account) => {
              const ready = () => {
                if (!apply(account)) return false;
                // Re-check for the sign-in form whenever the dropdown's contents change.
                new MutationObserver(() => styleLoginForms(account.shadowRoot)).observe(account.shadowRoot, {
                  childList: true,
                  subtree: true,
                });
                styleLoginForms(account.shadowRoot);
                return true;
              };
              if (ready()) return;
              // The shadow root can attach a moment after definition.
              let tries = 0;
              const timer = setInterval(() => {
                if (ready() || ++tries > 40) clearInterval(timer);
              }, 100);
            });
          });
        })();
      </script>
    </div>
  {% else %}
    <a
      href="{{ routes.account_login_url }}"
      class="header-actions__action header-actions__login{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="Log in"
    >
      <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">Log in</span>
      <span class="svg-wrapper account-button__icon{% if display_style != 'icon' %} desktop:hidden{% endif %}" aria-hidden="true">
        {{ account_icon }}
      </span>
    </a>
  {% endif %}

  <span
    ref="liveRegion"
    class="visually-hidden"
    role="status"
    data-testid="cart-count-live-region"
  ></span>
</header-actions>

<script
  type="module"
  src="{{ 'header-actions.js' | asset_url }}"
  fetchpriority="low"
></script>

{% stylesheet %}
  .header {
    --account-offset-top: calc(
      var(--header-group-height) + (var(--header-height) * var(--transparent-header-offset-boolean))
    );

    &[data-sticky-state='active'] {
      --account-offset-top: calc(var(--header-height) - 1px);
    }
  }

  .account-button {
    background: transparent;
  }

  /* <shopify-account> loads asynchronously and then renders a 44px button, which
     made the header grow 44px -> 60px after first paint. The hero is offset by the
     header height measured at first paint, so it sat ~16px low until header.js
     re-measured. Reserve the final height up front so the header never changes. */
  @media screen and (min-width: 750px) {
    .account-button {
      min-height: 44px;
    }
  }

  .account-button__icon,
  .account-button__text,
  .header-actions__login {
    color: var(--color-account-icon);
    transition: color var(--header-content-transition-timing);
    -webkit-font-smoothing: antialiased;
  }

  shopify-account {
    --shopify-account-font-heading: var(--font-body--family);
    --shopify-account-font-heading-weight: var(--font-body--weight);
    --shopify-account-font-heading-transform: uppercase;
    --shopify-account-font-body: var(--font-body--family);
    --shopify-account-font-body-weight: var(--font-body--weight);
    --shopify-account-radius-base: 0px;
    --shopify-account-radius-dialog: 0px;
    --shopify-account-radius-button: 0px;
    --shopify-account-radius-button-small: 0px;
    --shopify-account-radius-input: 0px;
    --shopify-account-color-background: var(--color-background);
    --shopify-account-color-text: var(--color-foreground);
    --shopify-account-color-accent: var(--color-primary-button-background);
    --shopify-account-color-accent-text: var(--color-primary-button-text);
    --shopify-account-dialog-position-top: var(--account-offset-top);
    --shopify-account-color-background-subdued: transparent !important;
    --shopify-account-color-shadow: transparent !important;

    &:not(:defined) {
      min-width: 0;
      width: auto;
      height: auto;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      line-height: normal;
    }
  }

  .header__column--right .account-button,
  .header__column--right .account-button shopify-account {
    min-width: 0;
    width: auto;
    height: auto;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 0;
    margin: 0;
  }

  .account-button__icon {
    display: block;
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }

  .account-button__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .account-button__fallback {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--shopify-account-color-accent, #0a142f);
  }

  .account-button--text shopify-account {
    color: inherit;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  header-actions {
    display: flex;
    align-items: center;
    /* Match left nav link spacing (--menu-horizontal-gap on .header) */
    gap: var(--menu-horizontal-gap, 3.25rem);
    padding-inline-end: 0;

    @media screen and (max-width: 749px) {
      justify-self: flex-end;
      gap: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .header__column--right header-actions {
      margin-inline-start: 0;
    }

    .header-actions__action {
      --button-size: 40px;
    }

    .header-actions__action:not(.account-button) .svg-wrapper {
      height: var(--button-size);
      width: var(--button-size);
    }

    .header-actions__action:not(.account-button) svg {
      width: 18px;
      height: 18px;
    }

    .account-button,
    .header-actions__login {
      grid-area: rightA;
      justify-self: center;
    }

    .header__column--right .account-button,
    .header__column--right .account-button shopify-account {
      width: 40px;
      height: 40px;
      justify-content: center;
    }

    .header__column--right .account-button shopify-account {
      --shopify-account-avatar-size: 40px;
      --shopify-account-signed-in-avatar-size: 10px !important;
    }

    .account-button__icon {
      width: 18px;
      height: 18px;
    }

    .account-button__fallback {
      width: 10px;
      height: 10px;
    }

    .header-sku-search {
      flex-shrink: 0;
    }
  }

  @media screen and (min-width: 750px) {
    /* Size wrappers to the icon so gap equals the visible space between glyphs */
    .header-actions__action:not(.account-button) .svg-wrapper {
      height: var(--icon-size-md);
      width: var(--icon-size-md);
    }

    /* Same for the account icon: <shopify-account> otherwise draws its button 44px wide around a
       15px icon (or a 28px avatar), adding extra space either side of it. */
    .header__column--right .account-button shopify-account {
      --shopify-account-avatar-size: var(--icon-size-md);
    }

    .header-actions--text {
      gap: var(--menu-horizontal-gap, 3.25rem);
    }

    .header-actions__text-style {
      font-size: var(--header-actions-font-size);
      font-family: var(--header-actions-font-family);
      font-weight: var(--header-actions-font-weight);
      text-transform: var(--header-actions-text-case);
    }
  }

  #header-component[data-menu-style='drawer'] header-actions {
    justify-self: flex-end;
  }

  .header__column--right header-actions {
    margin-inline-start: 0;
  }

  .header-actions__action.header-actions__instagram {
    color: var(--color-foreground);
  }

  .header-actions__action.header-actions__instagram:hover {
    color: var(--color-foreground);
  }

  .header-actions__cart-icon {
    --cart-bubble-size: 14px;
    --cart-bubble-top: -4px;
    --cart-bubble-right: -6px;

    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }

  /* Mobile wrappers are 40px touch targets; pin the badge to the 18px glyph corner */
  @media screen and (max-width: 749px) {
    .header-actions__cart-icon {
      --cart-bubble-size: 13px;
      --cart-bubble-top: 6px;
      --cart-bubble-right: 6px;
    }
  }

  .header-actions__action:has(.header-actions__cart-icon) {
    overflow: visible;
  }

  .header-actions__cart-icon .cart-bubble,
  .header-actions__cart-icon .cart-bubble[data-maintain-ratio] {
    position: absolute;
    z-index: 1;
    width: auto;
    min-width: var(--cart-bubble-size, 14px);
    height: var(--cart-bubble-size, 14px);
    top: var(--cart-bubble-top);
    right: var(--cart-bubble-right);
    padding-inline: 3px;
    box-sizing: border-box;
    aspect-ratio: auto;
  }

  @media screen and (min-width: 750px) {
    .header-actions__cart-icon--text.header-actions__cart-icon .cart-bubble {
      position: relative;
      top: 0;
      right: 0;
    }
  }

  .header-actions__cart-icon .cart-bubble__text {
    font-family: var(--font-paragraph--family);
    font-weight: 500;
    font-size: 0.5625rem; /* 9px — sits cleanly in the corner badge */
    line-height: 1;
  }

  .cart-bubble.cart-bubble--animating .cart-bubble__background {
    animation: grow var(--animation-speed) var(--animation-easing);
  }

  .cart-bubble--animating .cart-bubble__text {
    --start-y: -1em;
    --start-opacity: 1;
    /* Set initial transform state before animation starts */
    transform: translate(0, var(--start-y, -1em));
    opacity: var(--start-opacity, 1);
    animation: move-and-fade var(--animation-speed) var(--animation-easing);
  }

  cart-icon:has(.cart-bubble__text-count:empty) {
    --cart-bubble-size: 8px;
    --cart-bubble-top: -1px;
    --cart-bubble-right: -1px;
  }

  @media screen and (min-width: 750px) {
    cart-icon.header-actions__cart-icon--text:has(.cart-bubble__text-count:empty) {
      --cart-bubble-right: 0;
    }
  }

  .header-actions__text {
    display: flex;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .header-actions__cart-icon--text {
      display: flex;
      align-items: center;
      gap: var(--gap-xs);
    }

    .header__column--right .header-actions--text {
      margin-inline-start: 0;
    }
  }
{% endstylesheet %}
