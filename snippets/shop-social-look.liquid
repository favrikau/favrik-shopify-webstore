{%- doc -%}
  Content for one Shop Social "look", rendered into a <template> and cloned into the
  Shop Social modal on click. Kept data-source agnostic so a metaobject can feed it later.

  @param {object} [image] - Look image; renders a placeholder when blank
  @param {string} [placeholder] - Placeholder SVG name
  @param {string} [caption] - Description of the look
  @param {string} [author] - Handle credited in the meta line, e.g. "@favrik"
  @param {string} [date] - Display date for the meta line
  @param {string} [source_label] - Platform name for the meta line, defaults to "Instagram"
  @param {string} [source_url] - Link to the original post
  @param {object[]} [products] - Products worn in the look
  @param {object} [product] - Single product worn in the look (used when products is blank)
  @param {object} [preview_collection] - Collection for four-product carousel preview
  @param {boolean} [show_product_slots] - Render empty product slots when no products are attached
  @param {boolean} [force_four_product_preview] - Always render four carousel slides on this look
{%- enddoc -%}

{% liquid
  assign source_label = source_label | default: 'Instagram'
  assign placeholder = placeholder | default: 'lifestyle-1'
  assign product_count = 0
  assign product_display_limit = 4
  assign use_four_product_preview = false

  if force_four_product_preview and preview_collection != blank and preview_collection.products_count > 0
    assign use_four_product_preview = true
  endif

  if use_four_product_preview
    assign product_count = preview_collection.products_count
    if product_count > product_display_limit
      assign product_count = product_display_limit
    endif
  elsif products != blank
    assign product_count = products.size
    if product_count > product_display_limit
      assign product_count = product_display_limit
    endif
  elsif product != blank
    assign product_count = 1
  endif
%}

<template data-shop-social-look>
  <div class="shop-social-look__media" data-look-media>
    {% if image != blank %}
      {{
        image
        | image_url: width: 1600
        | image_tag:
          widths: '640, 900, 1200, 1600',
          sizes: '(min-width: 750px) 50vw, 100vw',
          class: 'shop-social-look__img',
          alt: image.alt
      }}
    {% else %}
      {{ placeholder | placeholder_svg_tag: 'shop-social-look__img shop-social-look__img--placeholder' }}
    {% endif %}
  </div>

  <div class="shop-social-look__content" data-look-content>
    {% if product_count > 1 %}
      {% capture product_slides %}
        {% if use_four_product_preview %}
          {% for slot in (1..product_count) %}
            {% assign product_offset = slot | minus: 1 %}
            {% for look_product in preview_collection.products limit: 1 offset: product_offset %}
              {% capture slide_children %}
                {% render 'shop-social-look-product', product: look_product, product_instance: slot %}
              {% endcapture %}
              {% assign slide_id = look_product.id | append: '-' | append: slot %}
              {% render 'slideshow-slide',
                index: product_offset,
                children: slide_children,
                class: 'shop-social-look__slide',
                slide_id: slide_id
              %}
            {% endfor %}
          {% endfor %}
        {% elsif products != blank %}
          {% for look_product in products limit: product_display_limit %}
            {% capture slide_children %}
              {% render 'shop-social-look-product', product: look_product, product_instance: forloop.index %}
            {% endcapture %}
            {% render 'slideshow-slide',
              index: forloop.index0,
              children: slide_children,
              class: 'shop-social-look__slide',
              slide_id: look_product.id
            %}
          {% endfor %}
        {% endif %}
      {% endcapture %}

      {% render 'slideshow',
        class: 'shop-social-look__carousel',
        slides: product_slides,
        slide_count: product_count,
        infinite: false,
        show_arrows: false,
        attributes: 'data-shop-social-product-carousel data-page-size-desktop="2" data-page-size-mobile="2"'
      %}
    {% elsif product_count > 0 %}
      <ul class="shop-social-look__products list-unstyled" data-count="1">
        <li>{% render 'shop-social-look-product', product: product, product_instance: 1 %}</li>
      </ul>
    {% elsif show_product_slots %}
      <ul class="shop-social-look__products list-unstyled" data-count="2">
        {% for i in (1..2) %}
          <li class="shop-social-look__slot">
            <span class="shop-social-look__slot-media">{{ 'product-apparel-1' | placeholder_svg_tag }}</span>
            <span class="shop-social-look__slot-label">Product {{ i }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if caption != blank %}
      <div class="shop-social-look__caption">{{ caption | escape | newline_to_br }}</div>
    {% endif %}

    {% if author != blank or date != blank %}
      <p class="shop-social-look__meta">
        {%- if author != blank -%}
          <span>{{ author | escape }}</span>
        {%- endif -%}
        {%- if source_label != blank -%}
          <span aria-hidden="true"> // </span>
          {%- if source_url != blank -%}
            <a href="{{ source_url }}" target="_blank" rel="noopener">{{ source_label | escape }}</a>
          {%- else -%}
            <span>{{ source_label | escape }}</span>
          {%- endif -%}
        {%- endif -%}
        {%- if date != blank -%}
          <span aria-hidden="true"> // </span>
          <span>{{ date | escape }}</span>
        {%- endif -%}
      </p>
    {% endif %}
  </div>
</template>
