{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
    {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    overlay
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% assign cart_drawer_title = 'content.cart_title' | t %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <div
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                <div class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </div>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </div>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    height: auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    padding-block-start: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  @media screen and (max-width: 749px) {
    .cart-drawer__summary {
      gap: 0.5rem;
      --cart-drawer-summary-padding: var(--padding-md);
      padding-block: var(--cart-drawer-summary-padding);
      padding-inline: var(--cart-drawer-padding);
    }

    .cart-drawer .cart-actions summary {
      min-height: 0;
      padding-block: 0.2rem;
      line-height: 1.15;
    }

    .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)),
    .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
      padding-block-start: 0.75rem;
    }
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

  /* Favrik cart drawer typography and alignment */
  #cart-drawer {
    --cart-drawer-type-size: 0.75rem;
    --cart-drawer-type-weight: 300;
  }

  #cart-drawer
    :is(
      .theme-drawer__title,
      .theme-drawer__badge,
      .cart-items__details,
      .cart-items__details *,
      .cart-items__price,
      .cart-items__price *,
      .cart-items__quantity,
      .cart-items__quantity *,
      .cart-totals,
      .cart-totals *,
      .cart-actions,
      .cart-actions *,
      .cart__checkout-button,
      .cart__checkout-button *,
      .cart-items__empty-button,
      .cart-items__empty-button *
    ) {
    font-family: var(--font-body--family);
    font-size: var(--cart-drawer-type-size);
    font-weight: var(--cart-drawer-type-weight);
    line-height: 1.4;
  }

  #cart-drawer
    :is(
      .theme-drawer__title,
      .cart-items__title,
      .cart-items__variants,
      .cart-items__price,
      .cart-note__label,
      .cart-discount__label,
      .cart-totals__item,
      .cart-totals__total,
      .cart-totals__tax-note,
      .cart__checkout-button,
      .cart-items__empty-button
    ) {
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #cart-drawer .theme-drawer__header {
    position: relative;
    z-index: 1;
    background-color: var(--color-background);
    border-bottom: 0.5px solid rgb(48 33 24 / 0.12);
  }

  #cart-drawer .cart-drawer__summary {
    border-top: 0.5px solid rgb(48 33 24 / 0.12);
  }

  #cart-drawer .theme-drawer__title {
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-weight: 600;
  }

  #cart-drawer .theme-drawer__close-button {
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--color-foreground);
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  @media screen and (max-width: 749px) {
    #cart-drawer {
      --theme-drawer-padding: 16px;
      --cart-drawer-padding: 16px;
    }

    #cart-drawer .theme-drawer__header {
      min-height: 48px;
      padding-block: 0.5rem;
      padding-inline: var(--theme-drawer-padding);
      box-sizing: border-box;
    }

    #cart-drawer .theme-drawer__close-button {
      width: 1.75rem;
      height: 1.75rem;
    }
  }

  #cart-drawer .theme-drawer__close-button:hover:not(:active) {
    color: var(--color-foreground);
    background: transparent;
    box-shadow: none;
  }

  #cart-drawer .theme-drawer__close-button .svg-wrapper,
  #cart-drawer .theme-drawer__close-button svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  #cart-drawer .theme-drawer__badge {
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.35rem;
    line-height: 1;
  }

  #cart-drawer .cart-items__table-row--full-width-variants {
    grid-template-columns: clamp(4.5rem, 22%, 6rem) minmax(0, 1fr) max-content;
    grid-template-rows: min-content min-content minmax(0, 1fr) min-content min-content;
    grid-template-areas:
      'media details price'
      'media variants variants'
      'media . .'
      'media quantity quantity'
      'media error error';
    column-gap: 1rem;
    row-gap: 0.4rem;
    align-items: start;
  }

  #cart-drawer .cart-items__product-info,
  #cart-drawer .cart-items__title-row {
    min-width: 0;
    width: 100%;
  }

  #cart-drawer .cart-items__title-row {
    display: flex;
    align-items: baseline;
  }

  #cart-drawer .cart-items__title {
    display: block;
    color: var(--color-foreground);
    overflow-wrap: anywhere;
  }

  #cart-drawer .cart-items__details {
    color: rgb(var(--color-foreground-rgb) / 0.68);
  }

  #cart-drawer .cart-items__variants-wrapper,
  #cart-drawer .cart-items__variants,
  #cart-drawer .cart-items__price {
    margin: 0;
  }

  /* The right-side line total is the only visible price in the drawer. */
  #cart-drawer .cart-items__unit-price-wrapper {
    display: none;
  }

  #cart-drawer .cart-items__price {
    align-self: start;
    min-width: max-content;
    text-align: right;
    white-space: nowrap;
  }

  #cart-drawer .cart-items__quantity {
    align-self: end;
    width: 100%;
    margin-block-start: 0;
  }

  #cart-drawer .cart-items__quantity-controls {
    align-items: flex-end;
    justify-content: flex-start;
  }

  #cart-drawer .cart-items__quantity .quantity-selector {
    font-family: var(--font-body--family);
    font-size: var(--cart-drawer-type-size);
    font-weight: var(--cart-drawer-type-weight);
  }

  @media screen and (max-width: 749px) {
    #cart-drawer .cart-items__table-row,
    #cart-drawer .cart-items__table-row--full-width-variants {
      align-items: stretch;
    }

    #cart-drawer .cart-items__media-container {
      aspect-ratio: auto;
      min-height: 100%;
      height: auto;
    }

    #cart-drawer .cart-items__media-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  #cart-drawer .cart-items__price,
  #cart-drawer .cart-items__price *,
  #cart-drawer .cart-totals__original-value,
  #cart-drawer .cart-totals__total-value {
    font-weight: 500;
  }

  #cart-drawer .cart-totals__total {
    align-items: baseline;
    font-weight: var(--cart-drawer-type-weight);
  }

  #cart-drawer
    :is(
      .cart-totals__original-container,
      .cart-totals__original-container *,
      .cart-totals__total-label,
      .cart-totals__total-value,
      .cart-totals__free-shipping,
      .cart-totals__installments,
      .cart-totals__tax-note,
      .cart-totals__tax-note small,
      .cart-note__label,
      .cart-discount__label,
      .cart-discount__input,
      .cart-discount__button
    ) {
    font-family: var(--font-body--family);
    font-size: var(--cart-drawer-type-size);
    font-weight: var(--cart-drawer-type-weight);
  }

  #cart-drawer .cart-totals__free-shipping {
    font-size: var(--font-size--2xs);
    font-weight: 400;
  }

  #cart-drawer .cart-totals__free-shipping--unlocked {
    color: var(--color-success, #006400);
  }

  #cart-drawer .cart-discount__button,
  #cart-drawer .cart-discount__button:is(:hover, :focus-visible) {
    border-color: #302118;
    border-radius: 0;
    background: #302118;
    background-color: #302118;
    color: #f3eee7;
  }

  #cart-drawer .cart__checkout-button {
    border-radius: 0;
    font-family: var(--font-body--family);
    font-size: var(--cart-drawer-type-size);
    font-weight: var(--cart-drawer-type-weight);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
{% endstylesheet %}
