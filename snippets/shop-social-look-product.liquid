{%- doc -%}
  Product card inside the Shop Social modal: image, price, title and add to cart.
  Shows a size select when the product has more than one variant.

  @param {object} product - Product worn in the look
{%- enddoc -%}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_variants = false
  if product.has_only_default_variant == false
    assign has_variants = true
  endif
%}

<div class="shop-social-look__product">
  <a class="shop-social-look__product-media" href="{{ product.url }}">
    {% if product.featured_image != blank %}
      {{
        product.featured_image
        | image_url: width: 480
        | image_tag:
          widths: '240, 360, 480',
          sizes: '(min-width: 750px) 12rem, 40vw',
          class: 'shop-social-look__product-img',
          loading: 'lazy',
          alt: product.featured_image.alt | default: product.title
      }}
    {% else %}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'shop-social-look__product-img' }}
    {% endif %}
  </a>

  <p class="shop-social-look__product-price">
    {% if product.compare_at_price > product.price %}
      <s class="shop-social-look__product-compare">{{ product.compare_at_price | money }}</s>
    {% endif %}
    {{ product.price | money }}
  </p>
  <a class="shop-social-look__product-title" href="{{ product.url }}">{{ product.title | escape }}</a>

  <form class="shop-social-look__product-form" data-shop-social-add>
    {% if has_variants %}
      <label class="visually-hidden" for="ShopSocialVariant-{{ product.id }}">Choose an option for {{ product.title | escape }}</label>
      <select
        id="ShopSocialVariant-{{ product.id }}"
        class="shop-social-look__variant"
        name="id"
      >
        {% for variant in product.variants %}
          <option
            value="{{ variant.id }}"
            {% if variant == current_variant %}selected{% endif %}
            {% unless variant.available %}disabled{% endunless %}
          >
            {{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}
          </option>
        {% endfor %}
      </select>
    {% else %}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
    {% endif %}

    <button
      type="submit"
      class="shop-social-look__add"
      {% unless product.available %}disabled{% endunless %}
    >
      {%- if product.available -%}
        <span data-add-label>Add to cart</span>
      {%- else -%}
        Sold out
      {%- endif -%}
    </button>
  </form>
</div>
