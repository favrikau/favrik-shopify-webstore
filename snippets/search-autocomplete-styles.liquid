{% doc %}
  Shared styles for search autocomplete / suggestion dropdowns — solid, fully opaque panels.
{% enddoc %}

{% stylesheet %}
  /* Collection page SKU/name autocomplete */
  .facets__sku-search-results {
    background-color: var(--color-background);
    opacity: 1;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* Global predictive search suggestion panel */
  .predictive-search-dropdown,
  .predictive-search-form__content-wrapper,
  .predictive-search-form__content,
  .predictive-search-results__inner {
    background-color: var(--color-background);
    opacity: 1;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .predictive-search.color-custom-popover,
  .predictive-search.color-custom-popover .predictive-search-form__header-inner,
  .predictive-search.color-custom-popover .predictive-search-form__content-wrapper,
  .predictive-search.color-custom-popover .predictive-search-form__content {
    background-color: var(--color-background);
    opacity: 1;
  }

  .facets__sku-search-results {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 0.5rem);
    max-height: min(32rem, 62vh);
    overflow-y: auto;
    border: 0.5px solid rgb(48 33 24 / 0.14);
    box-shadow: 0 0.75rem 2rem rgb(48 33 24 / 0.14);
  }

  .facets__sku-search-option {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    min-height: 5.25rem;
    padding: 0.7rem;
    border: 0;
    border-bottom: 0.5px solid rgb(48 33 24 / 0.08);
    background: transparent;
    color: #302118;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
  }

  .facets__sku-search-option:last-child {
    border-bottom: 0;
  }

  .facets__sku-search-option:is(:hover, :focus-visible),
  .facets__sku-search-option.is-active {
    background: rgb(48 33 24 / 0.08);
    outline: none;
  }

  .facets__sku-search-option-image {
    position: relative;
    display: block;
    width: 4.25rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgb(48 33 24 / 0.06);
  }

  .facets__sku-search-option-image:not(.facets__sku-search-option-image--placeholder) img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .facets__sku-search-option-image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #4a3728;
  }

  .facets__sku-search-option-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    width: 100%;
    height: 100%;
    padding: 0.35rem 0.3rem;
    box-sizing: border-box;
  }

  .facets__sku-search-option-placeholder-logo {
    width: 58%;
    max-width: 2.35rem;
    height: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  .facets__sku-search-option-placeholder-text {
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 0.4375rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .facets__sku-search-option-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.38rem;
  }

  .facets__sku-search-option-title {
    display: block;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .facets__sku-search-option-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .facets__sku-search-option-match {
    display: block;
    min-width: 0;
    overflow: hidden;
    color: rgb(48 33 24 / 0.48);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .facets__sku-search-option-price {
    flex-shrink: 0;
    color: rgb(48 33 24 / 0.68);
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    line-height: 1;
    letter-spacing: 0.02em;
  }
{% endstylesheet %}
