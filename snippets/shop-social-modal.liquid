{%- doc -%}
  Shop Social look dialog. Place it inside the element that contains the
  [data-shop-social-tile] tiles; shop-social-modal.js listens there for clicks.

  @param {string} [label] - Accessible name for the dialog
{%- enddoc -%}

<shop-social-modal>
  <dialog class="shop-social-modal" aria-label="{{ label | default: 'Shop the look' | escape }}" data-shop-social-dialog>
    <div class="shop-social-modal__inner">
      <div class="shop-social-modal__media" data-modal-media></div>
      <div class="shop-social-modal__panel">
        <div class="shop-social-modal__header">
          <div class="shop-social-modal__nav">
            <button type="button" class="shop-social-modal__icon-button" aria-label="Previous look" data-modal-prev>
              <svg width="14" height="24" viewBox="0 0 6 10" fill="none" aria-hidden="true" focusable="false">
                <path d="M5 1L1 5L5 9" stroke="currentColor" stroke-width="0.5"/>
              </svg>
            </button>
            <button type="button" class="shop-social-modal__icon-button" aria-label="Next look" data-modal-next>
              <svg width="14" height="24" viewBox="0 0 6 10" fill="none" aria-hidden="true" focusable="false">
                <path d="M1 1L5 5L1 9" stroke="currentColor" stroke-width="0.5"/>
              </svg>
            </button>
          </div>
          <button type="button" class="shop-social-modal__icon-button" aria-label="Close" data-modal-close>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M3 3L21 21M21 3L3 21" stroke="currentColor" stroke-width="1"/>
            </svg>
          </button>
        </div>
        <div class="shop-social-modal__content" data-modal-content></div>
      </div>
    </div>
  </dialog>
</shop-social-modal>

<script src="{{ 'shop-social-modal.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  /*
   * Shared Shop Social tile + look modal styles. They live here (not in a section)
   * because Shopify only loads a file's stylesheet CSS when that file renders on the page,
   * and both the homepage Shop Social section and the Shop Insta gallery render
   * this snippet.
   */
  .shop-social__tile {
    position: relative;
    display: block;
    flex: 0 0 var(--shop-social-tile-width);
    width: var(--shop-social-tile-width);
    height: calc(var(--shop-social-tile-width) * 5 / 4);
    aspect-ratio: var(--shop-social-tile-ratio);
    overflow: hidden;
    scroll-snap-align: start;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    font: inherit;
    color: rgb(255 255 255);
    text-decoration: none;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    cursor: pointer;
    touch-action: pan-x;
    user-select: none;
    -webkit-user-select: none;
  }

  .shop-social__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .shop-social__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background-color: rgb(0 0 0 / 0.45);
    opacity: 0;
    transition: opacity 0.2s ease-out;
    pointer-events: none;
  }

  .shop-social__tile:hover .shop-social__overlay,
  .shop-social__tile:focus-visible .shop-social__overlay {
    opacity: 1;
  }

  .shop-social__icon {
    width: clamp(1.75rem, 2.6vw, 2.5rem);
    height: auto;
    transform: scale(0.9);
    transition: transform 0.2s ease-out;
  }

  .shop-social__tile:hover .shop-social__icon,
  .shop-social__tile:focus-visible .shop-social__icon {
    transform: scale(1);
  }

  .shop-social__label {
    font-family: var(--font-body--family);
    font-size: clamp(0.625rem, 0.9vw, 0.8125rem);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Look modal */
  .shop-social-modal {
    --shop-social-modal-bg: var(--color-background);
    --shop-social-modal-line: rgb(48 33 24 / 0.24);
    --shop-social-modal-muted: rgb(48 33 24 / 0.62);
    width: min(52rem, calc(100vw - 4rem));
    max-width: none;
    max-height: calc(100dvh - 4rem);
    margin: auto;
    padding: 1.25rem;
    border: 0;
    color: #302118;
    background: var(--shop-social-modal-bg);
    overflow: hidden;
  }

  .shop-social-modal::backdrop {
    background: rgb(48 33 24 / 0.28);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .shop-social-modal[open] {
    animation: shop-social-modal-in 0.25s var(--ease-out-cubic, ease);
  }

  .shop-social-modal,
  .shop-social-modal:focus,
  .shop-social-modal:focus-visible,
  .shop-social-modal *:focus,
  .shop-social-modal *:focus-visible {
    outline: none;
    box-shadow: none;
  }

  @keyframes shop-social-modal-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  .shop-social-modal__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    height: min(36rem, calc(100dvh - 6.5rem));
  }

  .shop-social-modal__media {
    min-height: 0;
    background-color: rgb(48 33 24 / 0.06);
  }

  .shop-social-look__media,
  .shop-social-look__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-social-look__media {
    position: relative;
  }

  /* Creator handle over the bottom-right of a playing video. */
  .shop-social-look__media-credit {
    position: absolute;
    right: 0.75rem;
    bottom: 0.625rem;
    z-index: 1;
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1;
    color: #fff;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.45);
    text-decoration: none;
    pointer-events: none;
  }

  a.shop-social-look__media-credit {
    pointer-events: auto;
  }

  /* Multi-image look gallery: the product card slideshow (chevrons + fade on desktop,
     swipe + progress bar on mobile). Card-gallery rules are mirrored here because the
     card-gallery stylesheet only loads on pages that render product cards. */
  .shop-social-look__gallery {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .shop-social-look__gallery .card-gallery__viewport {
    display: contents;
  }

  .shop-social-look__gallery :is(slideshow-component, slideshow-container, slideshow-slides) {
    height: 100%;
  }

  .shop-social-look__gallery slideshow-slide.shop-social-look__slide {
    position: relative;
    height: 100%;
  }

  .shop-social-look__gallery slideshow-component[data-fade-slides] slideshow-slides {
    display: grid;
    overflow: hidden;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .shop-social-look__gallery slideshow-component[data-fade-slides] slideshow-slide {
    grid-area: 1 / 1;
    width: 100%;
    opacity: 0;
    content-visibility: visible;
    pointer-events: none;
    transition: opacity 0.22s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1));
  }

  .shop-social-look__gallery slideshow-component[data-fade-slides] slideshow-slide[aria-hidden='false'] {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  .shop-social-look__gallery slideshow-arrows .slideshow-control {
    opacity: 1;
  }

  .shop-social-look__gallery slideshow-arrows .slideshow-control:disabled {
    display: none !important;
  }

  .shop-social-look__gallery > .card-gallery__progress {
    display: none;
  }

  /* Keep the creator handle clear of the mobile progress bar. */
  .shop-social-look__media--gallery .shop-social-look__media-credit {
    bottom: 1.125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-social-look__gallery slideshow-component[data-fade-slides] slideshow-slide {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .shop-social-look__gallery slideshow-component[data-mobile-card-swipe] slideshow-slides {
      display: flex;
      overflow-x: hidden;
      overflow-y: hidden;
      scroll-snap-type: none;
      scroll-behavior: auto;
      overscroll-behavior: contain;
      touch-action: pan-y;
      scrollbar-width: none;
    }

    .shop-social-look__gallery slideshow-component[data-mobile-card-swipe] slideshow-slides::-webkit-scrollbar {
      display: none;
    }

    .shop-social-look__gallery slideshow-component[data-mobile-card-swipe] slideshow-slide {
      grid-area: auto;
      flex: 0 0 100%;
      width: 100%;
      opacity: 1;
      pointer-events: auto;
      content-visibility: visible;
    }

    .shop-social-look__gallery slideshow-arrows {
      display: none !important;
    }

    .shop-social-look__gallery > .card-gallery__progress {
      position: absolute;
      inset-inline: 10px;
      bottom: 8px;
      z-index: 2;
      display: block;
      height: 1px;
      overflow: hidden;
      pointer-events: none;
      background: rgb(255 255 255 / 0.55);
    }

    .shop-social-look__gallery > .card-gallery__progress[hidden] {
      display: none;
    }

    .shop-social-look__gallery .card-gallery__progress-thumb {
      display: block;
      height: 100%;
      width: 20%;
      background: rgb(30 19 12 / 0.8);
      transform: translate3d(0, 0, 0);
      will-change: transform, width;
    }
  }

  a.shop-social-look__media-credit:hover,
  a.shop-social-look__media-credit:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .shop-social-modal__panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .shop-social-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block-end: 1.5rem;
  }

  .shop-social-modal__nav {
    display: flex;
    gap: 1.5rem;
  }

  .shop-social-modal__icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--minimum-touch-target, 44px);
    min-height: var(--minimum-touch-target, 44px);
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .shop-social-modal__icon-button:hover {
    opacity: 0.6;
  }

  .shop-social-modal__icon-button svg {
    display: block;
    max-width: none;
  }

  .shop-social-modal__content {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    min-width: 0;
    padding: 1rem;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }

  .shop-social-look__content {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    width: 100%;
    max-width: 22rem;
    min-width: 0;
    margin: auto;
    text-align: center;
    overflow: hidden;
  }

  .shop-social-look__content:has(.shop-social-look__carousel),
  .shop-social-look__content:has(.shop-social-look__products[data-count='2']),
  .shop-social-look__content:has(.shop-social-look__products[data-count='3']),
  .shop-social-look__content:has(.shop-social-look__products[data-count='4']) {
    max-width: min(100%, 26rem);
    text-align: left;
  }

  .shop-social-look__carousel {
    --slideshow-gap: 0.75rem;
    --peek-next-slide-size: 0px;
    --slide-width: calc((100% - var(--slideshow-gap)) / 2);
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .shop-social-look__carousel,
  .shop-social-look__carousel slideshow-container,
  .shop-social-look__carousel slideshow-slides,
  .shop-social-look__carousel .shop-social-look__slide {
    max-width: 100%;
    min-width: 0;
    background: transparent;
    background-color: transparent;
  }

  .shop-social-look__carousel slideshow-slides {
    align-items: flex-start;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    touch-action: pan-x;
    scroll-snap-type: x mandatory;
  }

  .shop-social-look__carousel .shop-social-look__slide {
    width: var(--slide-width);
    max-width: var(--slide-width);
    min-width: var(--slide-width);
    overflow: visible;
    content-visibility: visible;
    scroll-snap-align: none;
  }

  .shop-social-look__carousel .shop-social-look__slide:nth-child(2n + 1) {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .shop-social-look__products {
    display: flex;
    flex-flow: row nowrap;
    gap: 0.75rem;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    align-self: stretch;
    list-style: none;
  }

  .shop-social-look__products[data-count='1'] {
    max-width: 12rem;
    margin-inline: auto;
  }

  .shop-social-look__products[data-count='1'] > li {
    flex: 1 1 auto;
    width: 100%;
  }

  .shop-social-look__product {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
    width: 100%;
    text-align: left;
  }

  .shop-social-look__slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .shop-social-look__product-media {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    margin-block-end: 0.35rem;
    overflow: hidden;
    background: transparent;
  }

  .shop-social-look__slot-media {
    display: block;
    width: min(100%, 8.5rem);
    aspect-ratio: 2 / 3;
    margin-block-end: 0.75rem;
    overflow: hidden;
    background: transparent;
  }

  .shop-social-look__product-img,
  .shop-social-look__slot-media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-social-look__slot-media {
    border: 1px dashed var(--shop-social-modal-line);
    background: transparent;
  }

  .shop-social-look__product-price,
  .shop-social-look__product-title,
  .shop-social-look__slot-label {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: var(--font-body--weight);
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .shop-social-look__slot-label {
    color: var(--shop-social-modal-muted);
  }

  .shop-social-look__product-compare {
    margin-inline-end: 0.35em;
    color: var(--shop-social-modal-muted);
  }

  .shop-social-look__product-price {
    width: 100%;
    text-align: center;
  }

  a.shop-social-look__product-title {
    display: block;
    width: 100%;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  a.shop-social-look__product-title:hover {
    opacity: 0.65;
  }

  .shop-social-look__product-form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
    width: 100%;
    max-width: 100%;
    margin-block-start: 0.35rem;
  }

  .shop-social-look__product-form:has(
      .shop-social-look__variant,
      swatches-variant-picker-component,
      .variant-picker,
      .shop-social-look__options
    )
    .shop-social-look__add {
    margin-block-start: 0.75rem;
  }

  .shop-social-look__variant {
    width: 100%;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--shop-social-modal-line);
    border-radius: 0;
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
    background: transparent;
  }

  .shop-social-look__variant option {
    color: #302118;
    background: #ddd4cb;
  }

  .shop-social-look__add {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 0;
    border-radius: 0;
    font-family: var(--font-body--family);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #302118;
    background: rgb(255 247 236 / 0.82);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .shop-social-look__add:hover {
    opacity: 0.85;
  }

  .shop-social-look__add:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .shop-social-look__add[aria-busy='true'] {
    opacity: 0.6;
    cursor: progress;
  }

  .shop-social-look__caption {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: var(--font-body--weight);
    line-height: 1.65;
  }

  .shop-social-look__meta {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--shop-social-modal-muted);
  }

  .shop-social-look__meta a {
    color: inherit;
  }

  .shop-social-look__error {
    margin: 0;
    font-size: 0.6875rem;
    color: #ffb4a6;
  }

  @media screen and (max-width: 749px) {
    .shop-social-modal {
      width: 100vw;
      max-height: 100dvh;
      height: 100dvh;
      padding: 1.25rem;
    }

    .shop-social-modal__inner {
      display: flex;
      flex-direction: column;
      gap: 0;
      height: 100%;
      overflow-y: auto;
    }

    .shop-social-modal__media {
      flex: 0 0 auto;
      height: 72dvh;
    }

    .shop-social-modal__panel {
      position: static;
      flex: 1 0 auto;
    }

    .shop-social-modal__header {
      position: absolute;
      inset: 1.25rem 1.25rem auto;
      z-index: 2;
      padding: 0.25rem;
      color: #fff;
      mix-blend-mode: difference;
    }

    .shop-social-modal__content {
      flex: 0 0 auto;
      display: block;
      overflow: visible;
      padding: 2rem 0.75rem 2.5rem;
    }

    .shop-social-look__carousel .shop-social-look__slide {
      width: var(--slide-width);
      max-width: var(--slide-width);
      min-width: var(--slide-width);
    }

    .shop-social-look__variant,
    .shop-social-look__variant option,
    .shop-social-look__add {
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      font-weight: var(--font-body--weight);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-social__overlay,
    .shop-social__icon,
    .shop-social__arrow,
    .shop-social-modal__icon-button,
    .shop-social-look__add {
      transition: none;
    }

    .shop-social-modal[open] {
      animation: none;
    }
  }
{% endstylesheet %}
