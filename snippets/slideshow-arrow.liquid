{%- doc -%}
  Renders a slideshow arrow control

  @param {string} action - { 'previous' | 'next' } The action to perform when the arrow is clicked.
  @param {string} [icon_style] - { 'arrow' | 'chevron' } The style of the icon, defaults to 'arrow'.
  @param {string} [icon_shape] - { 'none' | 'circle' | 'square' } The shape of the icon background, defaults to 'none'.
  @param {string} [icon_size] - { 'small' | 'medium' | 'large' } The size of the icon, defaults to 'medium'.

  @example
  {%- render 'slideshow-arrow', action: 'previous' -%}
{%- enddoc -%}

{%- liquid
  assign style = icon_style | default: 'arrow'
  assign shape = icon_shape | default: 'none'

  if icon_style contains 'large'
    assign icon_size = 'large'
  endif
-%}

<button
  class="
    slideshow-control slideshow-control--{{ action }}
    {% if icon_size %} slideshow-control--{{ icon_size }}{% endif %}
    {% if shape != 'none' %} slideshow-control--shape-{{ shape }}{% endif %}
    slideshow-control--style-{{ style }}
    button button-unstyled button-unstyled--transparent
  "
  {% if action == 'previous' %}
    aria-label="{{ 'accessibility.slideshow_previous' | t }}"
  {% else %}
    aria-label="{{ 'accessibility.slideshow_next' | t }}"
  {% endif %}
  on:click="/{{ action }}"
  ref="{{ action }}"
>
  <span
    class="icon-chevron"
    style="width: 10px; height: 16px; display: block; line-height: 0;"
  >
    {%- if action == 'previous' -%}
      <svg
        width="10"
        height="16"
        viewBox="0 0 6 10"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
        style="width: 10px; height: 16px; max-width: none; aspect-ratio: auto; display: block;"
      >
        <path d="M5 1L1 5L5 9" stroke="currentColor" stroke-width="0.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="8"/>
      </svg>
    {%- else -%}
      <svg
        width="10"
        height="16"
        viewBox="0 0 6 10"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
        style="width: 10px; height: 16px; max-width: none; aspect-ratio: auto; display: block;"
      >
        <path d="M1 1L5 5L1 9" stroke="currentColor" stroke-width="0.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="8"/>
      </svg>
    {%- endif -%}
  </span>
</button>

{% stylesheet %}
  .slideshow-control--large {
    .svg-wrapper,
    svg {
      width: var(--slideshow-controls-icon);
      height: var(--slideshow-controls-icon);
    }
  }

  .slideshow-control .icon-chevron,
  .slideshow-control .icon-chevron svg {
    --icon-stroke-width: 0.75px;
    width: 10px;
    height: 16px;
    max-width: none;
    aspect-ratio: auto;
    display: block;
  }

  /* Slideshow control shape styles */
  .slideshow-control.slideshow-control--shape-square,
  .slideshow-control.slideshow-control--shape-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .slideshow-control.slideshow-control--shape-circle {
    border-radius: 50%;
  }

  .slideshow-control.slideshow-control--shape-square {
    border-radius: 0;
  }
{% endstylesheet %}
