{%- doc -%}
  Styles for the password layout: main content, password dialog, and email-signup
  used in the dialog. Rendered from layout/password.liquid (layouts cannot use the
  stylesheet tag directly).
{%- enddoc -%}

{% stylesheet %}
  body {
    background: #fff7ec;
  }

  .password-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #fff7ec;
  }

  .password-dialog {
    max-width: 100vw;
    max-height: 100svh;
    width: 100vw;
    height: 100svh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: #fff7ec;
    color: #302118;
    transition: opacity var(--animation-values), display var(--animation-speed) allow-discrete,
      overlay var(--animation-speed) allow-discrete;
  }

  .password-dialog::backdrop {
    display: none;
  }

  .password-dialog[open] {
    opacity: 1;
    top: 0;
    left: 0;
  }

  @starting-style {
    .password-dialog[open] {
      opacity: 0;
    }
  }

  .password-dialog:not([open]) {
    opacity: 0;
  }

  .password-dialog__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--padding-lg);
    height: 100%;
  }

  .password-dialog__heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: min(26rem, 100%);
    margin: 0 0 1.5rem;
  }

  .password-dialog__close-button {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    padding: 0;
    color: #302118;
    background: transparent;
    cursor: pointer;
  }

  .password-dialog__close-button svg {
    display: block;
    width: 0.7rem;
    height: 0.7rem;
  }

  .password-dialog__title,
  .password-dialog .field__input,
  .password-dialog .field__input::placeholder,
  .password-dialog__submit-button,
  .password-dialog .email-signup__message {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .password-page input.favrik-password__input,
  .password-page input.favrik-password__input::placeholder,
  .password-page .password-dialog input.field__input,
  .password-page .password-dialog input.field__input::placeholder,
  .password-page .password-dialog__title {
    font-family: var(--font-body--family);
    font-size: 0.75rem !important;
    font-weight: 300;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .password-dialog__title {
    margin: 0;
    color: #302118;
  }

  .password-dialog .email-signup__input-group {
    display: flex;
    width: min(26rem, 100%);
    border: 1px solid #302118;
    border-radius: 0;
  }

  .password-dialog .field__input {
    flex: 1 1 auto;
    min-width: 0;
    height: 2.75rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: 0;
    background: #fff7ec;
    color: #302118;
  }

  .password-dialog .field__input::placeholder {
    color: rgb(48 33 24 / 0.45);
  }

  .password-dialog .field__input:focus {
    outline: none;
  }

  .password-dialog__submit-button {
    flex: 0 0 auto;
    height: 2.75rem;
    padding: 0 1.1rem;
    border: 0;
    border-left: 1px solid #302118;
    border-radius: 0;
    background: #302118;
    color: #fff7ec;
  }

  .password-dialog .email-signup__message {
    padding-block-start: 0.75rem;
    color: #8a2a1b;
  }

  .storefront-password-form {
    max-width: 400px;
    width: 100%;
  }
{% endstylesheet %}
