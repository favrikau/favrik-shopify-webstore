{%- doc -%}
  Displays product labels (sale / favrik made / preorder) or the collection heading.

  @param {product} product - Product whose collection should be displayed.
  @param {string} [output] - `labels` (default) or `heading`
  @param {boolean} [force_preorder] - Show the PREORDER tag even if the product metafield is unset.
  @param {boolean} [show_pickup_only] - Show a PICKUP ONLY tag for products tagged "No Shipping". Passed by the cart only.
  @param {boolean} [include_launch_sale] - Also show the SALE tag while the sitewide launch discount
    (Theme settings → Prices) is on. Passed by the product page price only.
{%- enddoc -%}

{%- liquid
  assign output_mode = output | default: 'labels'
  assign product_collection = collection

  # "All products" style collections (any handle) and the homepage collection are never shown.
  assign skip_titles = 'all products,all' | split: ','
  assign current_collection_title = product_collection.title | downcase | strip
  if product_collection.handle == 'all' or product_collection.handle == 'all-products' or product_collection.handle == 'frontpage'
    assign product_collection = blank
  elsif skip_titles contains current_collection_title
    assign product_collection = blank
  endif

  if product_collection == blank
    assign preferred_handles = 'fw2026,on-sale' | split: ','

    for preferred_handle in preferred_handles
      for associated_collection in product.collections
        if associated_collection.handle == preferred_handle
          assign product_collection = associated_collection
          break
        endif
      endfor

      if product_collection != blank
        break
      endif
    endfor
  endif

  if product_collection == blank
    for associated_collection in product.collections
      assign associated_title = associated_collection.title | downcase | strip
      if associated_collection.handle == 'all' or associated_collection.handle == 'all-products' or associated_collection.handle == 'frontpage'
        continue
      endif
      if skip_titles contains associated_title
        continue
      endif
      assign product_collection = associated_collection
      break
    endfor
  endif

  assign collection_title_downcase = product_collection.title | downcase | strip
  assign show_collection_heading = false
  if product_collection != blank
    unless product_collection.handle == 'on-sale' or collection_title_downcase == 'on sale'
      assign show_collection_heading = true
    endunless
  endif

  assign is_on_sale = false
  if product.available and product.compare_at_price > product.price
    assign is_on_sale = true
  endif
  assign is_pickup_only = false
  if show_pickup_only
    for product_tag in product.tags
      assign product_tag_normalized = product_tag | downcase | strip
      if product_tag_normalized == 'no shipping'
        assign is_pickup_only = true
        break
      endif
    endfor
  endif

  # Sitewide launch sale: the product page shows the SALE tag on every available product.
  assign label_launch_discount = settings.launch_discount_percent | default: 0
  if include_launch_sale and label_launch_discount > 0 and product.available
    assign is_on_sale = true
  endif

  assign is_made_by_favrik = product.metafields.custom.made_by_favrik.value
  assign is_preorder = product.metafields['custom']['preorder'].value
  if force_preorder
    assign is_preorder = true
  endif
  # Metafield colour as before; red if the metafield is empty so the outline tag is never invisible.
  assign sale_badge_color = shop.metafields['custom']['sale_badge_color'].value | default: '#c8102e'
  assign favrik_made_badge_color = shop.metafields['custom']['favrik_made_badge_color'].value
  assign preorder_badge_color = shop.metafields['custom']['preorder_badge_color'].value
-%}

{%- if output_mode == 'heading' -%}
  {%- if show_collection_heading -%}
    <a
      class="product-title__collection"
      href="{{ product_collection.url }}"
    >
      {{- product_collection.title | escape -}}
    </a>
  {%- endif -%}
{%- elsif is_on_sale or is_made_by_favrik or is_preorder or is_pickup_only -%}
  <div class="product-price__labels">
    {%- if is_pickup_only -%}
      <span
        class="product-price__tag"
        style="--product-price-tag-color: var(--pickup-only-color, #b45309);"
      >
        PICKUP ONLY
      </span>
    {%- endif -%}
    {%- if is_on_sale -%}
      <span
        class="product-price__tag"
        style="--product-price-tag-color: {{ sale_badge_color }};"
      >
        {%- if label_launch_discount > 0 -%}WEBSITE LAUNCH SALE{%- else -%}SALE{%- endif -%}
      </span>
    {%- endif -%}
    {%- if is_made_by_favrik -%}
      <span
        class="product-price__tag"
        style="--product-price-tag-color: {{ favrik_made_badge_color }};"
      >
        FAVRIK MADE
      </span>
    {%- endif -%}
    {%- if is_preorder -%}
      <span
        class="product-price__tag"
        style="--product-price-tag-color: {{ preorder_badge_color }};"
      >
        PREORDER
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .product-price__labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
  }

  .product-price__tag {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin: 0;
    padding: 0.1rem 0.3rem;
    border: 0.5px solid var(--product-price-tag-color);
    border-radius: 0;
    color: var(--product-price-tag-color);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: var(--font-body--weight);
    line-height: 1.35;
    text-transform: uppercase;
    white-space: nowrap;
    background: transparent;
  }
{% endstylesheet %}
