{%- doc -%}
  Displays product labels (sale / favrik made / preorder) or the collection heading.

  @param {product} product - Product whose collection should be displayed.
  @param {string} [output] - `labels` (default) or `heading`
  @param {boolean} [force_preorder] - Show the PREORDER tag even if the product metafield is unset.
  @param {boolean} [show_pickup_only] - Show a PICKUP ONLY tag for products tagged "No Shipping". Passed by the cart only.
{%- enddoc -%}

{%- liquid
  assign output_mode = output | default: 'labels'
  assign product_collection = collection

  # "All products" style collections (any handle) and the homepage collection are never shown.
  assign skip_titles = 'all products,all' | split: ','
  assign current_collection_title = product_collection.title | downcase | strip
  if product_collection.handle == 'all' or product_collection.handle == 'all-products' or product_collection.handle == 'frontpage'
    assign product_collection = blank
  elsif skip_titles contains current_collection_title
    assign product_collection = blank
  endif

  if product_collection == blank
    assign preferred_handles = 'fw2026,on-sale' | split: ','

    for preferred_handle in preferred_handles
      for associated_collection in product.collections
        if associated_collection.handle == preferred_handle
          assign product_collection = associated_collection
          break
        endif
      endfor

      if product_collection != blank
        break
      endif
    endfor
  endif

  if product_collection == blank
    for associated_collection in product.collections
      assign associated_title = associated_collection.title | downcase | strip
      if associated_collection.handle == 'all' or associated_collection.handle == 'all-products' or associated_collection.handle == 'frontpage'
        continue
      endif
      if skip_titles contains associated_title
        continue
      endif
      assign product_collection = associated_collection
      break
    endfor
  endif

  assign collection_title_downcase = product_collection.title | downcase | strip
  assign show_collection_heading = false
  if product_collection != blank
    unless product_collection.handle == 'on-sale' or collection_title_downcase == 'on sale'
      assign show_collection_heading = true
    endunless
  endif

  assign is_on_sale = false
  if product.available and product.compare_at_price > product.price
    assign is_on_sale = true
  endif

  # Black Friday (products tagged "black-friday-2026", any case). During a Black Friday phase
  # (<html data-bf-phase>): a BLACK FRIDAY SALE tag above the title replaces the collection name,
  # and a red "NN% OFF" box under the price replaces the SALE tag. Outside it: unchanged.
  assign is_bf_tagged = false
  for product_tag in product.tags
    assign product_tag_normalized = product_tag | downcase | strip
    if product_tag_normalized == 'black-friday-2026'
      assign is_bf_tagged = true
      break
    endif
  endfor
  assign is_black_friday = false
  assign bf_discount_percent = 0
  if is_bf_tagged and is_on_sale
    assign is_black_friday = true
    assign bf_discount_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price
    # Show the nearest of 5, 10, 15 … 50 (e.g. 29% → 30%, 33% → 35%).
    assign bf_discount_percent = bf_discount_percent | divided_by: 5.0 | round | times: 5 | at_least: 5 | at_most: 50
  endif
  assign is_pickup_only = false
  if show_pickup_only
    for product_tag in product.tags
      assign product_tag_normalized = product_tag | downcase | strip
      if product_tag_normalized == 'no shipping'
        assign is_pickup_only = true
        break
      endif
    endfor
  endif


  assign is_made_by_favrik = product.metafields.custom.made_by_favrik.value
  assign is_preorder = product.metafields['custom']['preorder'].value
  if force_preorder
    assign is_preorder = true
  endif
  # Metafield colour as before; red if the metafield is empty so the outline tag is never invisible.
  assign sale_badge_color = shop.metafields['custom']['sale_badge_color'].value | default: '#c8102e'
  assign favrik_made_badge_color = shop.metafields['custom']['favrik_made_badge_color'].value
  assign preorder_badge_color = shop.metafields['custom']['preorder_badge_color'].value
-%}

{%- if output_mode == 'heading' -%}
  {%- if is_bf_tagged -%}
    {%- capture bf_collection_url -%}{%- render 'black-friday-collection-url' -%}{%- endcapture -%}
    <a
      class="product-title__collection product-title__bf-tag{% unless is_on_sale %} product-title__bf-tag--unpriced{% endunless %}"
      href="{{ bf_collection_url | strip }}"
    >
      {{- 'Black Friday Sale' -}}
    </a>
  {%- endif -%}
  {%- if show_collection_heading -%}
    <a
      class="product-title__collection{% if is_black_friday %} product-title__collection--bf-priced{% elsif is_bf_tagged %} product-title__collection--bf-unpriced{% endif %}"
      href="{{ product_collection.url }}"
    >
      {{- product_collection.title | escape -}}
    </a>
  {%- endif -%}
{%- elsif is_on_sale or is_made_by_favrik or is_preorder or is_pickup_only or is_bf_tagged -%}
  <div class="product-price__labels">
    {%- if is_bf_tagged and is_on_sale == false and show_pickup_only != true -%}
      {%- comment -%} PREVIEW ONLY: filled by black-friday-preview-prices with an emulated discount. {%- endcomment -%}
      <span
        class="product-price__tag product-price__tag--bf-unpriced"
        data-bf-pdp-discount
        data-product-id="{{ product.id }}"
        data-bf-price="{{ product.selected_or_first_available_variant.price }}"
      ></span>
    {%- endif -%}
    {%- if is_pickup_only -%}
      <span
        class="product-price__tag"
        style="--product-price-tag-color: var(--pickup-only-color, #4a4a4a);"
      >
        PICKUP ONLY
      </span>
    {%- endif -%}
    {%- if is_black_friday -%}
      {%- comment -%}
        Time-gated: the red "NN% OFF" box only while a Black Friday phase is live
        (<html data-bf-phase>, 27–30 Nov); the regular SALE tag shows at any other time.
      {%- endcomment -%}
      <span class="product-price__tag product-price__tag--black-friday">
        {{- bf_discount_percent }}% OFF
      </span>
      <span
        class="product-price__tag product-price__tag--bf-off"
        style="--product-price-tag-color: {{ sale_badge_color }};"
      >
        SALE
      </span>
    {%- elsif is_on_sale -%}
      <span
        class="product-price__tag"
        style="--product-price-tag-color: {{ sale_badge_color }};"
      >
        SALE
      </span>
    {%- endif -%}
    {%- if is_made_by_favrik -%}
      <span
        class="product-price__tag"
        style="--product-price-tag-color: {{ favrik_made_badge_color }};"
      >
        FAVRIK MADE
      </span>
    {%- endif -%}
    {%- if is_preorder -%}
      <span
        class="product-price__tag"
        style="--product-price-tag-color: {{ preorder_badge_color }};"
      >
        PREORDER
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .product-price__labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
  }

  .product-price__tag {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin: 0;
    padding: 0.1rem 0.3rem;
    border: 0.5px solid var(--product-price-tag-color);
    border-radius: 0;
    color: var(--product-price-tag-color);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: var(--font-body--weight);
    line-height: 1.35;
    text-transform: uppercase;
    white-space: nowrap;
    background: transparent;
  }

  /* Black Friday discount under the price: solid red "NN% OFF". Only during a Black Friday
     phase; otherwise the tagged product shows the regular SALE tag. */
  .product-price__tag--black-friday {
    display: none;
  }

  html[data-bf-phase] .product-price__tag--black-friday {
    display: inline-flex;
  }

  html[data-bf-phase] .product-price__tag--bf-off {
    display: none;
  }

  .product-price__tag--black-friday {
    border-color: #8a0b10;
    background: #8a0b10;
    color: #ffffff;
    letter-spacing: 0.06em;
  }

  /* Above the title: "Black Friday Sale" in the same plain style as the collection name it
     replaces (it uses the collection link's class), on every tagged product during a Black Friday
     phase (from 12am 27 Nov, Melbourne). */
  /* Higher specificity than the collection link's own `.product-title-stack .product-title__collection
     { display: block }` (this label reuses that class for its look). With equal specificity the
     winner depended on stylesheet bundle order — on staging the label leaked outside the sale and
     doubled up with the collection name. */
  .product-title-stack .product-title__collection.product-title__bf-tag {
    display: none;
  }

  html[data-bf-phase] .product-title-stack .product-title__collection.product-title__bf-tag {
    display: block;
  }

  .product-price__tag--bf-unpriced {
    display: none;
    border-color: #8a0b10;
    background: #8a0b10;
    color: #ffffff;
    letter-spacing: 0.06em;
  }

  html[data-bf-preview] .product-price__tag--bf-unpriced:not(:empty) {
    display: inline-flex;
  }

  html[data-bf-phase] .product-title__collection--bf-priced,
  html[data-bf-phase] .product-title__collection--bf-unpriced {
    display: none !important;
  }
{% endstylesheet %}
