{%- doc -%}
  Variant picker styles consolidated into a single snippet for reliable CSS subsetting.
  Rendered from both the variant-main-picker snippet (product pages, where the picker
  originally renders) and from the product-card-related blocks and sections that can
  spawn a quick-add modal (collection/search pages), so the dropdown variant picker
  styles are available when the quick-add modal injects a variant picker via fetched
  product page HTML.

  @example
  {% render 'variant-picker-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* Variant picker container styles - unique to main variant picker */
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  /* Dropdown variant option styles */
  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-variant-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
    color: var(--color-variant-text);
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
    color: var(--color-variant-hover-text);
  }

  .variant-option__select-wrapper:hover .variant-option__select {
    background-color: var(--color-variant-hover-background);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    background-color: var(--color-variant-background);
    color: inherit;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  /* Variant picker alignment modifiers */
  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }

  .product-details .variant-option__button-label,
  .product-details .variant-option__button-label::before,
  .product-details .variant-option__button-label::after,
  .product-details .variant-option__button-label__pill {
    border-radius: 0;
  }

  .product-details .variant-option__label {
    display: block;
    width: 100%;
    margin: 0 0 0.5rem;
    padding: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-paragraph--size, 1rem);
    font-weight: var(--font-body--weight);
    line-height: var(--font-paragraph--line-height, var(--font-body--line-height));
    letter-spacing: var(--letter-spacing-global, normal);
    color: var(--variant-option-label-color, var(--color-foreground));
    text-transform: uppercase;
  }

  /* Color buttons: fill the row, fit more side by side, shared borders */
  .product-details .variant-option--color {
    --variant-min-width: 4.25rem;
    --variant-color-box-border: 0.5px solid rgb(48 33 24 / 0.22);
    --color-selected-variant-background: transparent;
    --color-selected-variant-hover-background: transparent;
    --color-selected-variant-text: var(--color-variant-text);
    --color-selected-variant-hover-text: var(--color-variant-text);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--variant-min-width), 1fr));
    gap: 0;
    width: 100%;
  }

  .product-details .variant-option--color > .variant-option__label {
    grid-column: 1 / -1;
  }

  .product-details .variant-option__button-label--color,
  .product-details .variant-option__button-label:has(.variant-option__color-chip) {
    flex: 1 1 auto;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: auto;
    padding-block: 10px;
    padding-inline: 8px;
    border: var(--variant-color-box-border, 0.5px solid rgb(48 33 24 / 0.22));
    margin-inline-end: -0.5px;
    margin-block-end: -0.5px;
    background-color: transparent;
    box-shadow: none;
    color: var(--color-variant-text);
  }

  .product-details .variant-option__button-label--color:hover,
  .product-details .variant-option__button-label:has(.variant-option__color-chip):hover {
    background-color: transparent;
    border-color: rgb(48 33 24 / 0.4);
    color: var(--color-variant-text);
    z-index: 1;
  }

  /* Selected: thicker border only — no filled background */
  .product-details .variant-option__button-label--color .variant-option__button-label__pill,
  .product-details .variant-option__button-label:has(.variant-option__color-chip) .variant-option__button-label__pill {
    display: none;
    background: transparent;
  }

  .product-details .variant-option__button-label--color:has(:checked),
  .product-details .variant-option__button-label--color:has(:checked):hover,
  .product-details .variant-option__button-label:has(.variant-option__color-chip):has(:checked),
  .product-details .variant-option__button-label:has(.variant-option__color-chip):has(:checked):hover {
    background-color: transparent;
    background-image: none;
    border-color: rgb(48 33 24 / 0.95);
    box-shadow: inset 0 0 0 1.5px rgb(48 33 24 / 0.95);
    color: var(--color-variant-text);
    z-index: 2;
  }

  /* Out of stock colors: greyed out and not selectable */
  .product-details .variant-option__button-label--color.variant-option__button-label--unavailable,
  .product-details .variant-option__button-label--color:has([data-option-available='false']),
  .product-details .variant-option__button-label:has(.variant-option__color-chip):has([data-option-available='false']) {
    cursor: not-allowed;
    pointer-events: none;
    opacity: 0.42;
    color: rgb(48 33 24 / 0.45);
    background-color: rgb(48 33 24 / 0.04);
    border-color: rgb(48 33 24 / 0.12);
    box-shadow: none;
    filter: grayscale(1);
  }

  .product-details .variant-option__button-label--color.variant-option__button-label--unavailable:hover,
  .product-details .variant-option__button-label--color:has([data-option-available='false']):hover,
  .product-details .variant-option__button-label:has(.variant-option__color-chip):has([data-option-available='false']):hover {
    background-color: rgb(48 33 24 / 0.04);
    border-color: rgb(48 33 24 / 0.12);
    color: rgb(48 33 24 / 0.45);
    box-shadow: none;
    z-index: 0;
  }

  .product-details .variant-option__button-label--color.variant-option__button-label--unavailable .variant-option__color-chip,
  .product-details .variant-option__button-label--color:has([data-option-available='false']) .variant-option__color-chip,
  .product-details .variant-option__button-label:has(.variant-option__color-chip):has([data-option-available='false']) .variant-option__color-chip {
    opacity: 0.55;
  }

  .product-details .variant-option__button-label--color::before,
  .product-details .variant-option__button-label--color::after,
  .product-details .variant-option__button-label:has(.variant-option__color-chip)::before,
  .product-details .variant-option__button-label:has(.variant-option__color-chip)::after {
    display: none;
    content: none;
  }

  .variant-option__color-chip {
    position: relative;
    z-index: 2;
    display: block;
    width: 22px;
    height: 6px;
    flex-shrink: 0;
    background-color: var(--variant-color-chip);
    border: 0.5px solid rgb(48 33 24 / 0.22);
    border-radius: 0;
    pointer-events: none;
  }

  .variant-option__color-chip--light {
    border-color: rgb(48 33 24 / 0.14);
  }

  .product-details .variant-option__button-label--color .variant-option__button-label__text,
  .product-details .variant-option__button-label:has(.variant-option__color-chip) .variant-option__button-label__text {
    text-align: center;
  }

  /* Size buttons: thicker border outline when selected — no filled background */
  .product-details .variant-option--size {
    --color-selected-variant-background: transparent;
    --color-selected-variant-hover-background: transparent;
    --color-selected-variant-text: var(--color-variant-text);
    --color-selected-variant-hover-text: var(--color-variant-text);
  }

  .product-details .variant-option__button-label--size {
    background-color: transparent;
    color: var(--color-variant-text);
    box-shadow: none;
  }

  .product-details .variant-option__button-label--size:hover {
    background-color: transparent;
    color: var(--color-variant-text);
    border-color: rgb(48 33 24 / 0.4);
  }

  .product-details .variant-option__button-label--size .variant-option__button-label__pill {
    display: none;
    background: transparent;
  }

  .product-details .variant-option__button-label--size:has(:checked),
  .product-details .variant-option__button-label--size:has(:checked):hover {
    background-color: transparent;
    background-image: none;
    border-color: rgb(48 33 24 / 0.95);
    box-shadow: inset 0 0 0 1.5px rgb(48 33 24 / 0.95);
    color: var(--color-variant-text);
    z-index: 2;
  }

  .product-details .variant-option__button-label--size::before,
  .product-details .variant-option__button-label--size::after {
    display: none;
    content: none;
  }
{% endstylesheet %}
