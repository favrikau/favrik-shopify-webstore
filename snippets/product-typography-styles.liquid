{% doc %}
  Product page typography — matches the site-wide Poppins / Nanum Gothic stack.
{% enddoc %}

{% stylesheet %}
  .product-information,
  .product-recommendations,
  .sticky-add-to-cart {
    :is(
        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        p,
        label,
        summary,
        .product-section-heading,
        button,
        .text-block,
        .text-block > *,
        .disclosures__heading,
        .disclosures__summary-item-title,
        .disclosures__separator,
        .accordion__summary,
        .product-shipping-returns,
        .product-shipping-returns__content,
        .product-shipping-returns__heading,
        .product-shipping-returns__subheading,
        .variant-picker__label,
        .variant-option__label,
        .sticky-add-to-cart__title,
        .sticky-add-to-cart__variant
      ):not(.price):not(.compare-at-price):not(.unit-price):not(.price-per-item) {
      font-family: var(--font-body--family);
      font-style: var(--font-body--style);
    }

    /* Match product-card title weight. */
    .product-details .text-block :is(h2, h3, h4, h5, h6),
    .sticky-add-to-cart__title {
      font-weight: var(--font-body--weight);
    }

    .product-details .text-block > h1,
    .product-details .text-block.custom-typography > h1,
    .product-details h1 {
      --font-size: 1.25rem;
      --font-weight: 400;
      font-size: 1.25rem !important;
      font-weight: 400 !important;
    }

    @media screen and (max-width: 749px) {
      .product-details .text-block:has(> h1) > *,
      .product-details .text-block > h1,
      .product-details .text-block.custom-typography > h1,
      .product-details h1 {
        --font-size: 1rem;
        --max-width: 100%;
        width: 100%;
        max-width: 100%;
        max-inline-size: 100%;
        font-size: 1rem !important;
        text-wrap: wrap;
      }
    }

    :lang(ko):is(
        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        p,
        label,
        summary,
        .product-section-heading,
        button,
        .text-block,
        .text-block > *,
        .disclosures__heading,
        .disclosures__summary-item-title,
        .accordion__summary,
        .product-shipping-returns,
        .product-shipping-returns__content,
        .product-shipping-returns__heading,
        .product-shipping-returns__subheading,
        .variant-picker__label,
        .sticky-add-to-cart__title,
        .sticky-add-to-cart__variant
      ) {
      font-family: var(--font-korean--family);
    }
  }

  .product-recommendations .section-resource-list__content {
    min-width: 0;
    max-width: 100%;
  }

  .product-recommendations .section-resource-list__content > .text-block,
  .product-recommendations .section-resource-list__content > .text-block :is(h1, h2, h3, h4, h5, h6, p) {
    font-size: 0.875rem;
    font-weight: var(--font-body--weight);
    line-height: 1.3;
    overflow: visible;
    text-overflow: unset;
    white-space: normal;
    overflow-wrap: break-word;
    max-width: 100%;
    min-width: 0;
  }
{% endstylesheet %}
