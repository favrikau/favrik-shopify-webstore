{%- liquid
  assign output = description | default: ''
  assign material_product = product | default: closest.product
  assign material_value = blank

  if material_product != blank
    assign material_metafield = material_product.metafields.custom.material
    if material_metafield == blank
      assign material_metafield = material_product.metafields['custom']['material']
    endif
    if material_metafield.value != blank
      assign material_value = material_metafield.value
    endif
  endif

  if material_value != blank
    assign material_value = material_value | strip
  endif
-%}
{%- if output == blank and material_value == blank -%}
{%- else -%}
  {%- liquid
    assign paragraphs = output | split: '</p>'
    assign cleaned_paragraphs = ''

    for paragraph in paragraphs
      assign chunk = paragraph | strip
      if chunk == blank
        continue
      endif

      assign chunk_plain = chunk | strip_html | strip
      assign is_featured_callout = false

      if chunk_plain contains 'Featured in the'
        assign is_featured_callout = true
      elsif chunk_plain contains 'featured in the'
        assign is_featured_callout = true
      elsif chunk contains '𝘍𝘦𝘢𝘵𝘶𝘳𝘦𝘥'
        assign is_featured_callout = true
      elsif chunk_plain contains 'Featured in' and chunk_plain contains 'Collection'
        assign is_featured_callout = true
      endif

      unless is_featured_callout
        if cleaned_paragraphs != blank
          assign cleaned_paragraphs = cleaned_paragraphs | append: '</p>'
        endif
        assign cleaned_paragraphs = cleaned_paragraphs | append: chunk
      endunless
    endfor

    if cleaned_paragraphs != blank and cleaned_paragraphs contains '<p'
      unless cleaned_paragraphs contains '</p>'
        assign cleaned_paragraphs = cleaned_paragraphs | append: '</p>'
      endunless
    endif
  -%}
  {{- cleaned_paragraphs -}}
  {%- if material_value != blank -%}
    <p class="product-description__material">
      <span class="product-description__material-label">Material:</span>
      {{ material_value | escape }}
    </p>
  {%- endif -%}
{%- endif -%}
