{%- doc -%}
  Renders the cart summary totals.

  @param {string} [accelerated_checkout_buttons_layout] - { 'vertical' } Forced layout of the additional checkout buttons, instead of relying on platform's layout.
  @param {string} [section_id] - The section ID for cart discount component.
{%- enddoc -%}

{% render 'text-component-shimmer-styles' %}

{%- liquid
  # Pickup-only items (product tag "No Shipping", any case) can't ship with other items.
  # A cart of only pickup-only items checks out normally; a mixed cart must be split.
  assign pickup_only_keys = ''
  assign cart_has_shippable_item = false
  for item in cart.items
    assign item_is_pickup_only = false
    for product_tag in item.product.tags
      assign product_tag_normalized = product_tag | downcase | strip
      if product_tag_normalized == 'no shipping'
        assign item_is_pickup_only = true
        break
      endif
    endfor
    if item_is_pickup_only
      assign pickup_only_keys = pickup_only_keys | append: item.key | append: ','
    else
      assign cart_has_shippable_item = true
    endif
  endfor
  assign cart_needs_split = false
  if pickup_only_keys != blank and cart_has_shippable_item
    assign cart_needs_split = true
  endif
-%}

{%- liquid
  # Savings breakdown built from the same numbers the cart lines show, so it reads top to bottom:
  # original price (compare-at where set) − sale − each discount = subtotal.
  assign summary_original_total = 0
  assign summary_sale_saving = 0
  # Black Friday: savings on items tagged "black-friday-2026" are labelled BLACK FRIDAY SALE during
  # a Black Friday phase (<html data-bf-phase>); outside it everything shows as one "Sale" line.
  assign summary_bf_saving = 0
  for item in cart.items
    assign summary_line_original = item.original_line_price
    if item.variant.compare_at_price > item.original_price
      assign summary_line_original = item.variant.compare_at_price | times: item.quantity
      assign summary_line_saving = summary_line_original | minus: item.original_line_price
      assign summary_sale_saving = summary_sale_saving | plus: summary_line_saving
      for product_tag in item.product.tags
        assign product_tag_normalized = product_tag | downcase | strip
        if product_tag_normalized == 'black-friday-2026'
          assign summary_bf_saving = summary_bf_saving | plus: summary_line_saving
          break
        endif
      endfor
    endif
    assign summary_original_total = summary_original_total | plus: summary_line_original
  endfor
  assign summary_total_saving = summary_original_total | minus: cart.total_price
  assign summary_other_sale_saving = summary_sale_saving | minus: summary_bf_saving
-%}

<div class="cart-totals">
  {% # We need to keep this node in place to allow morphing to work properly # %}
  <div class="cart-totals__original-container cart-primary-typography">
    {%- if summary_total_saving > 0 -%}
      <span class="cart-totals__item cart-totals__original">
        <span class="cart-totals__original-label">Original price</span>
        <s
          class="cart-totals__original-value cart-totals__original-value--struck cart-secondary-typography"
          data-testid="cart-subtotal-value"
        >
          {{- summary_original_total | money -}}
        </s>
      </span>
      <ul
        class="cart-discounts"
        role="list"
        aria-label="{{ 'content.discounts' | t }}"
      >
        {%- if summary_sale_saving > 0 -%}
          {%- comment -%} Outside a Black Friday phase (or no Black Friday items): one "Sale" line. {%- endcomment -%}
          <li class="cart-discounts__item{% if summary_bf_saving > 0 %} cart-discounts__item--bf-off{% endif %}">
            <span class="cart-discounts__label">
              {{- 'icon-discount.svg' | inline_asset_content -}}
              Sale
            </span>
            <span class="cart-discounts__value cart-secondary-typography"
              >-{{ summary_sale_saving | money -}}
            </span>
          </li>
        {%- endif -%}
        {%- if summary_bf_saving > 0 -%}
          {%- comment -%} During a Black Friday phase: Black Friday items, then any other sale items. {%- endcomment -%}
          <li class="cart-discounts__item cart-discounts__item--bf">
            <span class="cart-discounts__label">
              {{- 'icon-discount.svg' | inline_asset_content -}}
              BLACK FRIDAY SALE
            </span>
            <span class="cart-discounts__value cart-secondary-typography"
              >-{{ summary_bf_saving | money -}}
            </span>
          </li>
          {%- if summary_other_sale_saving > 0 -%}
            <li class="cart-discounts__item cart-discounts__item--bf">
              <span class="cart-discounts__label">
                {{- 'icon-discount.svg' | inline_asset_content -}}
                Sale
              </span>
              <span class="cart-discounts__value cart-secondary-typography"
                >-{{ summary_other_sale_saving | money -}}
              </span>
            </li>
          {%- endif -%}
        {%- endif -%}
        {%- for discount in cart.discount_applications -%}
          {%- if discount.total_allocated_amount > 0 -%}
            <li class="cart-discounts__item">
              <span class="cart-discounts__label">
                {{- 'icon-discount.svg' | inline_asset_content -}}
                {{ discount.title | escape }}
              </span>
              <span class="cart-discounts__value cart-secondary-typography"
                >-{{ discount.total_allocated_amount | money -}}
              </span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {% if settings.show_cart_note %}
    <div class="cart-actions">
      {% if settings.show_cart_note %}
        <script
          type="module"
          src="{{ 'cart-note.js' | asset_url }}"
        ></script>

        <cart-note style="display: flex;">
          {% capture cart_note_accordion_children %}
            <details
              {% if settings.cart_note_open_by_default %}
                open
              {% endif %}
            >
              <summary class="cart-note__summary">
                <span class="cart-note__label cart-primary-typography">
                  {{ 'content.seller_note' | t }}
                </span>

                <span class="cart-totals__icon">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </span>
              </summary>

              <div class="details-content cart-note__inner">
                <label
                  for="cart-note"
                  class="visually-hidden"
                >
                  {{- 'content.seller_note' | t -}}
                </label>
                <textarea
                  form="cart-form"
                  on:input="/updateCartNote"
                  id="cart-note"
                  class="cart-note__instructions"
                  name="note"
                  data-skip-node-update
                >{{ cart.note }}</textarea>
              </div>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component',
            children: cart_note_accordion_children,
            class: 'cart-note',
            open_by_default_on_desktop: settings.cart_note_open_by_default,
            open_by_default_on_mobile: settings.cart_note_open_by_default
          %}
        </cart-note>
      {% endif %}
    </div>
  {% endif %}

  {%- liquid
    if settings.currency_code_enabled_cart_total
      assign total_price = cart.total_price | money_with_currency
    else
      assign total_price = cart.total_price | money
    endif

    # Free shipping counts the real amount to pay (cart.total_price is after every discount,
    # including order-level ones), not the pre-discount items subtotal.
    assign free_shipping_threshold_cents = 18000
    assign free_shipping_unlocked = false
    if cart.total_price >= free_shipping_threshold_cents
      assign free_shipping_unlocked = true
    else
      assign free_shipping_remaining_cents = free_shipping_threshold_cents | minus: cart.total_price
      assign free_shipping_remaining = free_shipping_remaining_cents | money
    endif

    assign cart_has_preorder = false
    for item in cart.items
      if item.product.metafields['custom']['preorder'].value
        assign cart_has_preorder = true
        break
      endif
      if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'continue' and item.variant.inventory_quantity <= 0
        assign cart_has_preorder = true
        break
      endif
    endfor
  -%}

  <div class="cart-totals__container{% if settings.show_installments %} cart-totals__container--has-installments{% endif %}">
    <span
      class="cart-totals__item cart-totals__total"
      role="status"
    >
      <span class="cart-totals__total-label cart-primary-typography">{{ 'content.cart_subtotal' | t }}</span>
      <text-component
        ref="cartTotal"
        value="{{ total_price | strip_html }}"
        class="cart-totals__total-value cart-secondary-typography"
        {% comment %} Used by payment_terms web component {% endcomment %}
        data-testid="cart-total-value"
        data-cart-subtotal
      >
        {{ total_price }}
      </text-component>
    </span>
    {% if cart != empty %}
      <p
        class="cart-totals__free-shipping cart-primary-typography{% if free_shipping_unlocked %} cart-totals__free-shipping--unlocked{% endif %}"
        role="status"
      >
        {% if free_shipping_unlocked %}
          <span class="cart-totals__free-shipping-icon" aria-hidden="true">
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
          </span>
          Free shipping unlocked
        {% else %}
          {{ free_shipping_remaining }} away from free shipping
        {% endif %}
      </p>
      {%- if cart_has_preorder -%}
        <details
          class="cart-totals__preorder-note"
          open
          data-skip-node-update
        >
          <summary class="cart-totals__preorder-note-summary">
            <span class="cart-totals__preorder-note-title">Important: this preorder will not ship yet</span>
            <span class="icon-plus cart-totals__preorder-note-toggle" aria-hidden="true">
              {{- 'icon-plus.svg' | inline_asset_content -}}
            </span>
          </summary>
          <p class="cart-totals__preorder-note-text">
            Orders containing both in-stock and preorder items will be dispatched together once all items are available. To receive in-stock items sooner, please place them in a separate order.
          </p>
        </details>
      {%- endif -%}
    {% endif %}
    {% if settings.show_installments %}
      <span class="cart-totals__item cart-totals__installments">
        {% form 'cart', cart %}
          {{ form | payment_terms }}
        {% endform %}
      </span>
    {% endif %}
  </div>
</div>

<div class="cart__ctas">
  {%- if cart_needs_split -%}
    <div class="cart__pickup-notice" id="cart-pickup-notice" role="status">
      <p class="cart__pickup-notice-text">Order pickup-only items separately</p>
      <button
        type="button"
        class="cart__pickup-notice-remove"
        data-pickup-only-keys="{{ pickup_only_keys | escape }}"
        aria-label="Remove pickup-only items from cart"
        on:click="cart-items-component/removePickupOnlyItems"
      >
        Remove them
      </button>
    </div>
  {%- endif -%}
  <button
    type="submit"
    id="checkout"
    class="cart__checkout-button button"
    name="checkout"
    {% if cart == empty or cart_needs_split %}
      disabled
    {% endif %}
    {% if cart_needs_split %}
      aria-describedby="cart-pickup-notice"
    {% endif %}
    form="cart-form"
  >
    <span class="button-text">
      {{ 'content.checkout' | t }}
    </span>
  </button>

  {%- comment -%} Express checkout (Shop Pay, Apple Pay…) would bypass the split rule, so it's hidden for mixed carts. {%- endcomment -%}
  {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons and cart_needs_split == false %}
    <div
      class="
        additional-checkout-buttons
        {% if accelerated_checkout_buttons_layout == 'vertical' %}additional-checkout-buttons--vertical{% endif %}
      "
    >
      {{ content_for_additional_checkout_buttons }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  /* Mixed cart (pickup-only + shipped): one compact bar, text left, action right.
     Dark grey = pickup-only everywhere (this bar + the PICKUP ONLY tag); red stays for sale. */
  .cart__pickup-notice {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
    padding: 0.375rem 0.375rem 0.375rem 0.625rem;
    border: 0.5px solid var(--pickup-only-color);
    background: rgb(74 74 74 / 0.06);
    font-family: var(--font-body--family);
    font-size: var(--favrik-body-size, 0.6875rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--pickup-only-color);
  }

  .cart__pickup-notice-text {
    min-width: 0;
    margin: 0;
  }

  .cart__pickup-notice-remove {
    flex: 0 0 auto;
    margin: 0;
    padding: 0.3rem 0.55rem;
    border: 0;
    border-radius: 0;
    background: var(--pickup-only-color);
    font: inherit;
    color: #ffffff;
    white-space: nowrap;
    cursor: pointer;
  }

  .cart__pickup-notice-remove:hover {
    background: #2e2e2e;
  }

  .cart__pickup-notice-remove:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .cart__checkout-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-block: 0.5px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block: 0;
    margin-block-start: var(--margin-3xs);
  }

  .cart-actions__divider {
    border-block-start: 0.5px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-totals:not(:has(.cart-actions)) {
    margin-block-start: 0;
    border-block-start: none;
    padding-block-start: 0;
  }

  .cart-totals__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-totals__tax-note {
    display: block;
    align-items: flex-start;
    color: var(--color-foreground-subdued);
  }

  .cart-totals__tax-note a {
    color: var(--color-foreground-subdued);
    text-decoration-line: underline;
    text-decoration-color: currentColor;

    &:hover {
      text-decoration-color: transparent;
    }
  }

  .cart-totals__tax-note small {
    display: block;
    font-size: 0.6875rem;
  }

  .cart-discounts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Black Friday split of the sale savings (time-gated): */
  .cart-discounts__item--bf {
    display: none !important;
  }

  html[data-bf-phase] .cart-discounts__item--bf {
    display: flex !important;
  }

  html[data-bf-phase] .cart-discounts__item--bf-off {
    display: none !important;
  }

  .cart-discounts__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discounts__label {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-discounts__label svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    display: inline-block;
  }

  .cart-totals__original-container,
  .cart-totals__container {
    display: flex;
    flex-direction: column;
  }

  .cart-totals__container {
    row-gap: var(--gap-2xs);

    &.cart-totals__container--has-installments {
      row-gap: var(--gap-xs);
    }
  }

  .cart-totals__original-container:empty {
    display: none;
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    width: 100%;
    border-block-start: none;

    &:has(> :first-child:not(.cart-totals__original-container, .cart-totals__container)) {
      padding-block-start: 0;
      border-block-start: none;
    }

    @media screen and (min-width: 750px) {
      padding-block-start: 0;
    }
  }

  .cart-totals__original-container,
  .cart-totals__original-container * {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__original-value {
    font-weight: 500;
  }

  /* Pre-sale total: grey and struck through so it never reads as the amount to pay. */
  .cart-totals__original-value--struck {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    text-decoration-line: line-through;
    text-decoration-thickness: 1px;
  }

  .cart-totals__original-container {
    row-gap: var(--gap-2xs);
  }

  .cart-discounts {
    display: flex;
    flex-direction: column;
    row-gap: var(--gap-2xs);
  }

  .cart-totals__total-value {
    font-weight: 600;
  }

  .cart-totals__total {
    align-items: baseline;
    font-weight: var(--font-weight-bold);
  }

  .cart-totals__total-label {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total-value {
    font-size: var(--cart-font-size--xl);

    @media screen and (max-width: 749px) {
      font-size: var(--font-size--lg);
    }
  }

  .cart-totals__free-shipping {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.35rem 0 0;
    color: var(--color-foreground-subdued);
    font-size: var(--font-size--2xs);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .cart-totals__free-shipping--unlocked {
    color: var(--color-success, #006400);
  }

  .cart-totals__free-shipping-icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
  }

  .cart-totals__free-shipping-icon svg {
    width: 100%;
    height: 100%;
  }

  .cart-totals__preorder-note {
    width: 100%;
    box-sizing: border-box;
    margin: 0.65rem 0 0;
    background: rgb(var(--color-foreground-rgb) / 0.06);
    border: 0.5px solid var(--color-foreground);
    color: var(--color-foreground);
  }

  .cart-totals__preorder-note-summary {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.7rem 0.75rem;
    box-sizing: border-box;
    cursor: pointer;
    list-style: none;
    color: var(--color-foreground);
  }

  .cart-totals__preorder-note-summary::-webkit-details-marker {
    display: none;
  }

  .cart-totals__preorder-note-summary:hover {
    color: var(--color-foreground);
  }

  .cart-totals__preorder-note-toggle {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 0.875rem;
    height: 0.875rem;
    margin-inline-start: auto;
    color: var(--color-foreground);
  }

  .cart-totals__preorder-note-toggle svg {
    width: 100%;
    height: 100%;
  }

  .cart-totals__preorder-note-title,
  .cart-totals__preorder-note-text {
    margin: 0;
    letter-spacing: 0;
    text-transform: none;
  }

  .cart-totals__preorder-note-title {
    flex: 1 1 auto;
    min-width: 0;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cart-totals__preorder-note-text {
    margin: 0;
    padding: 0 0.75rem 0.7rem;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .cart-totals__installments {
    color: var(--color-foreground);
    font-size: var(--font-size--2xs);
  }

  .cart-note {
    width: 100%;
  }

  @starting-style {
    .cart-note[open-by-default-on-desktop][open-by-default-on-mobile] .details-content {
      block-size: auto;
      opacity: 1;
      overflow-y: visible;
    }
  }

  .cart-note__inner {
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-note__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-note__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-note__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  .cart-note__instructions {
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    transition: box-shadow var(--animation-speed) ease;
    box-shadow: var(--input-box-shadow);
    min-height: 5.5rem;
    min-width: 100%;
    max-width: 100%;
    font-size: var(--font-size--sm);
    padding: max(4px, calc(var(--style-border-radius-inputs) * (1 - cos(45deg))));
  }

  .cart-totals__icon {
    height: var(--icon-size-xs);
    width: var(--icon-size-xs);
    margin: 0;
  }

  .cart__ctas {
    width: 100%;
    display: grid;
    gap: var(--checkout-button-gap);
    grid-auto-flow: row;
    grid-template-columns: 1fr;
  }

  .cart__ctas .cart__checkout-button {
    width: 100%;
    height: clamp(25px, var(--height-buy-buttons), 55px);
    padding-inline: var(--padding-4xl);
  }

  .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)) {
    border-block-start: none;
    padding-block-start: 0;
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  @media screen and (min-width: 750px) {
    .cart-summary--extend {
      height: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .cart-drawer__summary {
      gap: 0.5rem;
      --cart-drawer-summary-padding: var(--padding-md);
      padding-block: var(--cart-drawer-summary-padding);
      padding-inline: var(--cart-drawer-padding);
    }

    .cart-totals {
      gap: 0.45rem;
    }

    .cart-totals:not(:has(.cart-actions)) {
      padding-block-start: 0;
    }

    .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)) {
      padding-block-start: 0;
    }

    .cart-totals__container {
      row-gap: 0.1rem;
    }

    .cart-totals__total,
    .cart-totals__total-label,
    .cart-totals__total-value {
      line-height: 1.2;
    }

    .cart-totals__free-shipping {
      margin: 0.1rem 0 0;
      line-height: 1.2;
    }

    .cart-totals__tax-note,
    .cart-totals__tax-note small {
      line-height: 1.25;
    }

    .cart-actions summary {
      min-height: 0;
      padding-block: 0.2rem;
      line-height: 1.15;
    }

    .cart__ctas {
      gap: 0.45rem;
    }

    .cart__ctas .cart__checkout-button {
      margin-block-start: 0.15rem;
    }
  }
{% endstylesheet %}
