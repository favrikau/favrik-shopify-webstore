{% doc %}
  Static delivery promo banner at the top of every page.
  Visible only while the page is scrolled to the top; not dismissable.
{% enddoc %}

<style>
  .product-delivery-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    flex: 0 0 auto;
    overflow: hidden;
    background: #323232;
    color: rgb(255 247 236 / 0.92);
    border: none;
    position: relative;
    z-index: 2;
    height: var(--product-delivery-banner-height, 1.875rem);
    padding-block: 0.5rem;
    padding-inline: 1rem;
    text-align: center;
  }

  .product-delivery-banner__message {
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .header-section:has(> .product-delivery-banner) {
    --product-delivery-banner-height: 1.875rem;
  }
</style>

<div
  class="product-delivery-banner"
  id="product-delivery-banner"
  aria-label="Free delivery promotion"
>
  <span class="product-delivery-banner__message">
    Free delivery on orders over $150
  </span>
</div>
