{% doc %}
  Catalog overlay — blur backdrop with white category links on the left
  (same visual language as the header search overlay).
{% enddoc %}

{% liquid
  # "All products" opens the store's own All collection (sorted in admin); Shopify may have
  # given it a suffixed handle. Falls back to the built-in all-products page.
  assign all_collection = collections['all']
  if all_collection == blank or all_collection.id == blank
    assign all_collection = collections['all-1'] | default: collections['all-products']
  endif
  assign all_url = routes.all_products_collection_url
  assign all_handle = 'all'
  if all_collection != blank and all_collection.id != blank
    assign all_url = all_collection.url
    assign all_handle = all_collection.handle
  endif
  assign current_handle = collection.handle | default: ''
  assign new_arrivals_collection = collections['new-arrivals']
  assign best_sellers_collection = collections['best-sellers']
  assign sale_collection = collections['on-sale']
  assign coat_collection = collections['coat-collection']
  assign shop_insta_url = pages['shop-insta'].url | default: '/pages/shop-insta'
  assign locations_url = pages['locations'].url | default: '/pages/locations'
  assign contact_url = pages['contact'].url | default: '/pages/contact'

  # Black Friday link (red, top of the list) — only shown while a Black Friday phase is live
  # (<html data-bf-phase>, Theme settings → Black Friday). Same destination as the popup button.
  capture bf_url
    render 'black-friday-collection-url'
  endcapture
  assign bf_url = bf_url | strip
  assign bf_handle = bf_url | split: '/collections/' | last | split: '?' | first
%}

<div
  class="catalog-nav-drawer__backdrop"
  data-catalog-nav-backdrop
  hidden
  aria-hidden="true"
></div>

<aside
  class="catalog-nav-drawer"
  id="catalog-nav-drawer"
  data-catalog-nav-drawer
  hidden
  aria-hidden="true"
>
  <nav class="catalog-nav-drawer__panel" aria-label="Shop">
    {% liquid
      # Map each store product type (some use bold Unicode letters) to its plain lowercase name,
      # so the fixed category list below links to the real type.
      assign type_lookup = ''
      for product_type in shop.types
        if product_type == blank
          continue
        endif
        assign type_normalized = product_type | strip
        assign type_normalized = type_normalized | replace: '𝗔', 'A' | replace: '𝗕', 'B' | replace: '𝗖', 'C' | replace: '𝗗', 'D' | replace: '𝗘', 'E' | replace: '𝗙', 'F' | replace: '𝗚', 'G' | replace: '𝗛', 'H' | replace: '𝗜', 'I' | replace: '𝗝', 'J' | replace: '𝗞', 'K' | replace: '𝗟', 'L' | replace: '𝗠', 'M' | replace: '𝗡', 'N' | replace: '𝗢', 'O' | replace: '𝗣', 'P' | replace: '𝗤', 'Q' | replace: '𝗥', 'R' | replace: '𝗦', 'S' | replace: '𝗧', 'T' | replace: '𝗨', 'U' | replace: '𝗩', 'V' | replace: '𝗪', 'W' | replace: '𝗫', 'X' | replace: '𝗬', 'Y' | replace: '𝗭', 'Z'
        assign type_normalized = type_normalized | replace: '𝗮', 'A' | replace: '𝗯', 'B' | replace: '𝗰', 'C' | replace: '𝗱', 'D' | replace: '𝗲', 'E' | replace: '𝗳', 'F' | replace: '𝗴', 'G' | replace: '𝗵', 'H' | replace: '𝗶', 'I' | replace: '𝗷', 'J' | replace: '𝗸', 'K' | replace: '𝗹', 'L' | replace: '𝗺', 'M' | replace: '𝗻', 'N' | replace: '𝗼', 'O' | replace: '𝗽', 'P' | replace: '𝗾', 'Q' | replace: '𝗿', 'R' | replace: '𝘀', 'S' | replace: '𝘁', 'T' | replace: '𝘂', 'U' | replace: '𝘃', 'V' | replace: '𝘄', 'W' | replace: '𝘅', 'X' | replace: '𝘆', 'Y' | replace: '𝘇', 'Z'
        assign type_key = type_normalized | downcase
        assign type_lookup = type_lookup | append: '|||' | append: type_key | append: '::' | append: product_type
      endfor
      assign type_entries = type_lookup | split: '|||'
      assign category_names = 'Outer,Top,Knit,Bottom,Dress,Set,Acc,Home' | split: ','
    %}
    <ul class="catalog-nav-drawer__list list-unstyled">
      {%- if settings.bf_enabled -%}
        <li class="catalog-nav-drawer__bf">
          <a
            href="{{ bf_url }}"
            class="catalog-nav-drawer__link catalog-nav-drawer__link--bf{% if current_handle == bf_handle %} catalog-nav-drawer__link--active{% endif %}"
            {% if current_handle == bf_handle %}aria-current="page"{% endif %}
          >
            <span class="catalog-nav-drawer__bf-label" data-bf-label="sale">BLACK FRIDAY SALE</span>
            <span class="catalog-nav-drawer__bf-label" data-bf-label="monday">CYBER MONDAY</span>
          </a>
        </li>
        <li class="catalog-nav-drawer__divider catalog-nav-drawer__bf" aria-hidden="true"></li>
      {%- endif -%}
      <li>
        <a
          href="{{ all_url }}"
          class="catalog-nav-drawer__link{% if current_handle == all_handle %} catalog-nav-drawer__link--active{% endif %}"
          {% if current_handle == all_handle %}aria-current="page"{% endif %}
        >
          ALL PRODUCTS
        </a>
      </li>

      <li class="catalog-nav-drawer__divider" aria-hidden="true"></li>

      <li>
        <a
          href="{% if new_arrivals_collection != blank %}{{ new_arrivals_collection.url }}{% else %}{{ all_url }}?sort_by=created-descending{% endif %}"
          class="catalog-nav-drawer__link{% if current_handle == 'new-arrivals' %} catalog-nav-drawer__link--active{% endif %}"
          {% if current_handle == 'new-arrivals' %}aria-current="page"{% endif %}
        >
          NEW ARRIVALS
        </a>
      </li>
      <li>
        <a
          href="{% if best_sellers_collection != blank %}{{ best_sellers_collection.url }}{% else %}/collections/best-sellers{% endif %}"
          class="catalog-nav-drawer__link{% if current_handle == 'best-sellers' %} catalog-nav-drawer__link--active{% endif %}"
          {% if current_handle == 'best-sellers' %}aria-current="page"{% endif %}
        >
          BEST SELLERS
        </a>
      </li>

      <li class="catalog-nav-drawer__divider" aria-hidden="true"></li>

      {% for category_name in category_names %}
        {% liquid
          assign category_key = category_name | downcase
          assign category_type = category_name
          for entry in type_entries
            assign entry_parts = entry | split: '::'
            if entry_parts[0] == category_key
              assign category_type = entry_parts[1]
              break
            endif
          endfor
        %}
        <li>
          <a href="{{ category_type | url_for_type }}" class="catalog-nav-drawer__link">
            {{ category_name | upcase }}
          </a>
        </li>
      {% endfor %}

      <li class="catalog-nav-drawer__divider" aria-hidden="true"></li>

      {% liquid
        assign coat_url = ''
        if coat_collection != blank
          assign coat_url = coat_collection.url
        else
          assign coat_type = 'Coat collection'
          for entry in type_entries
            assign entry_parts = entry | split: '::'
            if entry_parts[0] == 'coat collection'
              assign coat_type = entry_parts[1]
              break
            endif
          endfor
          assign coat_url = coat_type | url_for_type
        endif
      %}
      <li>
        <a
          href="{{ coat_url }}"
          class="catalog-nav-drawer__link{% if current_handle == 'coat-collection' %} catalog-nav-drawer__link--active{% endif %}"
          {% if current_handle == 'coat-collection' %}aria-current="page"{% endif %}
        >
          COAT COLLECTION
        </a>
      </li>
      <li>
        <a
          href="{% if sale_collection != blank %}{{ sale_collection.url }}{% else %}/collections/on-sale{% endif %}"
          class="catalog-nav-drawer__link{% if current_handle == 'on-sale' %} catalog-nav-drawer__link--active{% endif %}"
          {% if current_handle == 'on-sale' %}aria-current="page"{% endif %}
        >
          SALE
        </a>
      </li>

      <li class="catalog-nav-drawer__divider" aria-hidden="true"></li>

      <li>
        <a
          href="{{ shop_insta_url }}"
          class="catalog-nav-drawer__link{% if page.handle == 'shop-insta' %} catalog-nav-drawer__link--active{% endif %}"
          {% if page.handle == 'shop-insta' %}aria-current="page"{% endif %}
        >
          SHOP INSTA
        </a>
      </li>
      <li>
        <a href="{{ locations_url }}" class="catalog-nav-drawer__link">STORE LOCATION</a>
      </li>
      <li>
        <a href="{{ contact_url }}" class="catalog-nav-drawer__link">CONTACT US</a>
      </li>
    </ul>
  </nav>
</aside>

<script
  type="module"
  src="{{ 'catalog-nav-drawer.js' | asset_url }}"
  fetchpriority="low"
></script>

{% stylesheet %}
  .catalog-nav-drawer__backdrop {
    position: fixed;
    /* Clear sticky header stack (delivery banner + bar), not just --header-height */
    top: var(--catalog-nav-top, calc(var(--header-height, 0px) - 1px));
    right: 0;
    bottom: 0;
    left: 0;
    width: auto;
    z-index: calc(var(--layer-menu-drawer) - 1);
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    border: 0;
    border-inline-end: 0.5px solid rgb(48 33 24 / 0.22);
    background: var(--color-background);
    background-color: var(--color-background);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    touch-action: none;
    cursor: default;
    transition:
      opacity 0.32s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1)),
      visibility 0.32s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1));
  }

  .catalog-nav-drawer__backdrop.is-visible,
  .catalog-nav-drawer__backdrop.is-visible:hover,
  .catalog-nav-drawer__backdrop.is-visible:focus {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    background: var(--color-background);
    background-color: var(--color-background);
  }

  .catalog-nav-drawer {
    position: fixed;
    top: var(--catalog-nav-top, calc(var(--header-height, 0px) - 1px));
    right: 0;
    bottom: 0;
    left: 0;
    z-index: var(--layer-menu-drawer);
    width: auto;
    max-width: none;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem);
    background: transparent;
    border: 0;
    box-shadow: none;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.32s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1)),
      visibility 0.32s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1));
  }

  .catalog-nav-drawer.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: none;
  }

  .catalog-nav-drawer__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: min(20rem, 100%);
    max-height: 100%;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: transparent;
    border: 0;
    box-shadow: none;
    pointer-events: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .catalog-nav-drawer__panel::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .catalog-nav-drawer__list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .catalog-nav-drawer__divider {
    /* Full nav-column hairline */
    width: 100%;
    max-width: 100%;
    height: 0;
    margin-block: 0.85rem 0.7rem;
    border: 0;
    border-block-start: 0.5px solid rgb(48 33 24 / 0.28);
  }

  .catalog-nav-drawer__link {
    display: block;
    padding: 0.45rem 0;
    color: #302118;
    font-family: var(--font-body--family);
    /* Matches the header menu link size (13px). */
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }

  .catalog-nav-drawer__link:hover {
    opacity: 0.62;
  }

  .catalog-nav-drawer__link--active {
    font-weight: 400;
    opacity: 1;
    color: #302118;
  }

  /* Black Friday link: red (the sale colour), only while a Black Friday phase is live. */
  .catalog-nav-drawer__bf,
  .catalog-nav-drawer__bf-label {
    display: none;
  }

  html[data-bf-phase] .catalog-nav-drawer__bf {
    display: list-item;
  }

  html[data-bf-phase='sale'] .catalog-nav-drawer__bf-label[data-bf-label='sale'],
  html[data-bf-phase='monday'] .catalog-nav-drawer__bf-label[data-bf-label='monday'] {
    display: inline;
  }

  .catalog-nav-drawer__link--bf,
  .catalog-nav-drawer__link--bf.catalog-nav-drawer__link--active {
    color: #8a0b10;
    font-weight: 400;
  }

  @media screen and (min-width: 750px) {
    .catalog-nav-drawer__backdrop,
    .catalog-nav-drawer {
      right: auto;
      width: calc((100% - var(--page-scrollbar-width, 0px)) / 3);
      max-width: calc((100% - var(--page-scrollbar-width, 0px)) / 3);
    }

    /* The panel spans the drawer's full height and carries the vertical padding
       itself, so the list starts padded but scrolls right up to the header edge and
       down to the viewport bottom instead of clipping at the padding line. */
    .catalog-nav-drawer {
      box-sizing: border-box;
      padding-block: 0;
      padding-inline: var(--page-margin, 40px);
    }

    .catalog-nav-drawer__panel {
      display: block;
      box-sizing: border-box;
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      padding-block: clamp(1rem, 3vw, 2.25rem) clamp(1.5rem, 4vw, 3rem);
    }

    .catalog-nav-drawer__divider {
      width: 100%;
      max-width: none;
    }
  }

  @media screen and (max-width: 749px) {
    .catalog-nav-drawer__backdrop,
    .catalog-nav-drawer {
      transform: translateX(-100%);
      opacity: 1;
      will-change: transform;
      transition:
        transform 0.38s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1)),
        visibility 0.38s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1));
    }

    .catalog-nav-drawer__backdrop.is-visible,
    .catalog-nav-drawer.is-open {
      transform: translateX(0);
    }

    .catalog-nav-drawer__list {
      gap: 0;
    }

    .catalog-nav-drawer__link {
      padding-block: 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-nav-drawer__backdrop,
    .catalog-nav-drawer {
      transition: none;
    }
  }
{% endstylesheet %}
