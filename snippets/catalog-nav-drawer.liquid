{% doc %}
  Catalog overlay — blur backdrop with white category links on the left
  (same visual language as the header search overlay).
{% enddoc %}

{% liquid
  assign all_url = routes.all_products_collection_url
  assign current_handle = collection.handle | default: ''
  assign test_collection = collections['test-collection']
  assign fw2026_collection = collections['fw2026']
  assign sale_collection = collections['on-sale']
  assign locations_url = pages['locations'].url | default: '/pages/locations'
  assign contact_url = pages['contact'].url | default: '/pages/contact'
%}

<div
  class="catalog-nav-drawer__backdrop"
  data-catalog-nav-backdrop
  hidden
  aria-hidden="true"
></div>

<aside
  class="catalog-nav-drawer"
  id="catalog-nav-drawer"
  data-catalog-nav-drawer
  hidden
  aria-hidden="true"
>
  <nav class="catalog-nav-drawer__panel" aria-label="Shop">
    <ul class="catalog-nav-drawer__list list-unstyled">
      <li>
        <a
          href="{{ all_url }}"
          class="catalog-nav-drawer__link{% if current_handle == 'all' %} catalog-nav-drawer__link--active{% endif %}"
          {% if current_handle == 'all' %}aria-current="page"{% endif %}
        >
          ALL PRODUCTS
        </a>
      </li>

      <li>
        <a
          href="{% if test_collection != blank %}{{ test_collection.url }}{% else %}/collections/test-collection{% endif %}"
          class="catalog-nav-drawer__link catalog-nav-drawer__link--secondary{% if current_handle == 'test-collection' %} catalog-nav-drawer__link--active{% endif %}"
          {% if current_handle == 'test-collection' %}aria-current="page"{% endif %}
        >
          TEST COLLECTION
        </a>
      </li>

      <li>
        <a
          href="{% if fw2026_collection != blank %}{{ fw2026_collection.url }}{% else %}/collections/fw2026{% endif %}"
          class="catalog-nav-drawer__link catalog-nav-drawer__link--secondary{% if current_handle == 'fw2026' %} catalog-nav-drawer__link--active{% endif %}"
          {% if current_handle == 'fw2026' %}aria-current="page"{% endif %}
        >
          FW2026
        </a>
      </li>

      <li>
        <a
          href="{% if sale_collection != blank %}{{ sale_collection.url }}{% else %}/collections/on-sale{% endif %}"
          class="catalog-nav-drawer__link catalog-nav-drawer__link--secondary{% if current_handle == 'on-sale' %} catalog-nav-drawer__link--active{% endif %}"
          {% if current_handle == 'on-sale' %}aria-current="page"{% endif %}
        >
          SHOP SALE
        </a>
      </li>

      <li class="catalog-nav-drawer__divider" aria-hidden="true"></li>

      {% liquid
        assign promo_types = ''
        assign promo_separator = '|||'
      %}

      {% for product_type in shop.types %}
        {% if product_type == blank %}
          {% continue %}
        {% endif %}

        {% liquid
          assign type_normalized = product_type | strip
          assign type_normalized = type_normalized | replace: '𝗔', 'A' | replace: '𝗕', 'B' | replace: '𝗖', 'C' | replace: '𝗗', 'D' | replace: '𝗘', 'E' | replace: '𝗙', 'F' | replace: '𝗚', 'G' | replace: '𝗛', 'H' | replace: '𝗜', 'I' | replace: '𝗝', 'J' | replace: '𝗞', 'K' | replace: '𝗟', 'L' | replace: '𝗠', 'M' | replace: '𝗡', 'N' | replace: '𝗢', 'O' | replace: '𝗣', 'P' | replace: '𝗤', 'Q' | replace: '𝗥', 'R' | replace: '𝗦', 'S' | replace: '𝗧', 'T' | replace: '𝗨', 'U' | replace: '𝗩', 'V' | replace: '𝗪', 'W' | replace: '𝗫', 'X' | replace: '𝗬', 'Y' | replace: '𝗭', 'Z'
          assign type_normalized = type_normalized | replace: '𝗮', 'A' | replace: '𝗯', 'B' | replace: '𝗰', 'C' | replace: '𝗱', 'D' | replace: '𝗲', 'E' | replace: '𝗳', 'F' | replace: '𝗴', 'G' | replace: '𝗵', 'H' | replace: '𝗶', 'I' | replace: '𝗷', 'J' | replace: '𝗸', 'K' | replace: '𝗹', 'L' | replace: '𝗺', 'M' | replace: '𝗻', 'N' | replace: '𝗼', 'O' | replace: '𝗽', 'P' | replace: '𝗾', 'Q' | replace: '𝗿', 'R' | replace: '𝘀', 'S' | replace: '𝘁', 'T' | replace: '𝘂', 'U' | replace: '𝘃', 'V' | replace: '𝘄', 'W' | replace: '𝘅', 'X' | replace: '𝘆', 'Y' | replace: '𝘇', 'Z'
          assign type_label = type_normalized | upcase
          assign type_key = type_label | downcase
          assign is_promo_type = false
          if type_key == 'coat collection' or type_key == 'eofy sale' or type_key == 'look five'
            assign is_promo_type = true
          endif
        %}

        {% if is_promo_type %}
          {% assign promo_types = promo_types | append: promo_separator | append: product_type | append: '::' | append: type_label %}
        {% else %}
          <li>
            <a
              href="{{ product_type | url_for_type }}"
              class="catalog-nav-drawer__link"
            >
              {{ type_label }}
            </a>
          </li>
        {% endif %}
      {% endfor %}

      {% if promo_types != blank %}
        <li class="catalog-nav-drawer__divider" aria-hidden="true"></li>

        {% assign promo_entries = promo_types | split: promo_separator %}
        {% for entry in promo_entries %}
          {% if entry == blank %}
            {% continue %}
          {% endif %}
          {% assign entry_parts = entry | split: '::' %}
          {% assign promo_type_raw = entry_parts[0] %}
          {% assign promo_type_label = entry_parts[1] %}
          <li>
            <a
              href="{{ promo_type_raw | url_for_type }}"
              class="catalog-nav-drawer__link"
            >
              {{ promo_type_label }}
            </a>
          </li>
        {% endfor %}
      {% endif %}

      <li class="catalog-nav-drawer__divider" aria-hidden="true"></li>

      <li>
        <a href="{{ locations_url }}" class="catalog-nav-drawer__link">STORE LOCATIONS</a>
      </li>
      <li>
        <a href="{{ contact_url }}" class="catalog-nav-drawer__link">CONTACT US</a>
      </li>
    </ul>
  </nav>
</aside>

<script
  type="module"
  src="{{ 'catalog-nav-drawer.js' | asset_url }}"
  fetchpriority="low"
></script>

{% stylesheet %}
  .catalog-nav-drawer__backdrop {
    position: fixed;
    /* Clear sticky header stack (delivery banner + bar), not just --header-height */
    top: var(--catalog-nav-top, calc(var(--header-height, 0px) - 1px));
    right: 0;
    bottom: 0;
    left: 0;
    width: auto;
    z-index: calc(var(--layer-menu-drawer) - 1);
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(50 50 50 / 0.65);
    background-color: rgb(50 50 50 / 0.65);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    touch-action: none;
    cursor: default;
    transition:
      opacity 0.32s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1)),
      visibility 0.32s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1));
  }

  .catalog-nav-drawer__backdrop.is-visible,
  .catalog-nav-drawer__backdrop.is-visible:hover,
  .catalog-nav-drawer__backdrop.is-visible:focus {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    background: rgb(50 50 50 / 0.65);
    background-color: rgb(50 50 50 / 0.65);
  }

  .catalog-nav-drawer {
    position: fixed;
    top: var(--catalog-nav-top, calc(var(--header-height, 0px) - 1px));
    right: 0;
    bottom: 0;
    left: 0;
    z-index: var(--layer-menu-drawer);
    width: auto;
    max-width: none;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem);
    background: transparent;
    border: 0;
    box-shadow: none;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.32s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1)),
      visibility 0.32s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1));
  }

  .catalog-nav-drawer.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: none;
  }

  .catalog-nav-drawer__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: min(20rem, 100%);
    max-height: 100%;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: transparent;
    border: 0;
    box-shadow: none;
    pointer-events: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .catalog-nav-drawer__panel::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .catalog-nav-drawer__list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .catalog-nav-drawer__divider {
    /* Full nav-column hairline */
    width: 100%;
    max-width: 100%;
    height: 0;
    margin-block: 0.85rem 0.7rem;
    border: 0;
    border-block-start: 0.5px solid rgb(255 255 255 / 0.35);
  }

  .catalog-nav-drawer__link {
    display: block;
    padding: 0.45rem 0;
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }

  .catalog-nav-drawer__link--secondary {
    color: rgb(255 255 255 / 0.58);
  }

  .catalog-nav-drawer__link:hover {
    opacity: 0.62;
  }

  .catalog-nav-drawer__link--secondary:hover {
    opacity: 1;
    color: rgb(255 255 255 / 0.82);
  }

  .catalog-nav-drawer__link--active {
    font-weight: 400;
    opacity: 1;
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .catalog-nav-drawer__list {
      gap: 0;
    }

    .catalog-nav-drawer__link {
      padding-block: 0.3rem;
      font-size: var(--font-size--xs, 0.8125rem);
    }
  }
{% endstylesheet %}
