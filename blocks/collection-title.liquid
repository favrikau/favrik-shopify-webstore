

{% liquid
  assign show_bilingual_title = false
  if template.name == 'index' and closest.collection != blank
    assign show_bilingual_title = true
  endif
%}

{% if closest.collection == blank %}
  {% assign text = 'placeholders.collection_title' | t %}
  {% assign collection_title = '<p>' | append: text | append: '</p>' %}
  {% render 'text', fallback_text: collection_title, block: block %}
{% elsif show_bilingual_title %}
  {% liquid
    assign collection_title_en = closest.collection.title | escape
    assign collection_title_ko = closest.collection.metafields.custom.korean_title.value | default: closest.collection.metafields.custom.korean_title

    if collection_title_ko == blank
      case closest.collection.handle
        when 'fw2026'
          assign collection_title_ko = '2026 가을/겨울 컬렉션'
        when 'on-sale'
          assign collection_title_ko = '세일'
      endcase
    endif

    assign collection_title_ko = collection_title_ko | default: closest.collection.title | escape
    capture collection_title
      echo '<p class="collection-title__en">'
      echo collection_title_en
      echo '</p><p class="collection-title__ko">'
      echo collection_title_ko
      echo '</p>'
    endcapture
  %}
  {% render 'text', fallback_text: collection_title, block: block, class: 'collection-title-bilingual' %}
{% elsif closest.collection != blank %}
  {% assign collection_title = '<p>' | append: closest.collection.title | append: '</p>' %}
  {% render 'text', fallback_text: collection_title, block: block %}
{% endif %}

{% stylesheet %}
  .collection-title-bilingual {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    color: var(--color, #fff7ec);
  }

  .collection-title-bilingual .collection-title__en,
  .collection-title-bilingual .collection-title__ko {
    margin-block: 0;
  }

  .collection-title-bilingual.text-block.h4 .collection-title__en {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-size: var(--font-h4--size);
    line-height: var(--font-h4--line-height);
    letter-spacing: var(--font-h4--letter-spacing);
    font-weight: var(--font-body--weight);
  }

  .collection-title-bilingual.text-block.h4 .collection-title__ko {
    font-family: var(--font-korean--family);
    font-size: calc(var(--font-h4--size) * 0.72);
    font-weight: 400;
    line-height: 1.25;
  }

  @media screen and (max-width: 749px) {
    .collection-title-bilingual.text-block.h4 .collection-title__en {
      font-size: 0.875rem;
      line-height: 1.25;
    }

    .collection-title-bilingual.text-block.h4 .collection-title__ko {
      font-size: calc(0.875rem * 0.72);
    }
  }
{% endstylesheet %}

